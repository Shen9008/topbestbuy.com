---
import ImageSlot from '../media/ImageSlot.astro';
import SaveButton from '../islands/SaveButton';
import Icon from '../ui/Icon.astro';
import { CRIT } from '../../data/scorecard';
import { SITE_DATE } from '../../data/meta';
import { formatRM, productFullName } from '../../lib/format';
import { resolveSources } from '../../lib/sources';
import SourceLink from '../ui/SourceLink.astro';
import { SCORE_CRIT_ICONS, type IconMapKey } from '../../icons';
import type { RankedProduct } from '../../lib/scoring';
import type { ListCatalog } from '../../data/lists';

interface Props {
  product: RankedProduct;
  list: ListCatalog[keyof ListCatalog];
}

const { product, list } = Astro.props;
const sources = resolveSources(product.X.s);
const fullName = productFullName(product);
---

<article
  class="tb-pick-card tb-card tb-card--editorial scroll-mt-32"
  id={product.id}
  data-product-card
  data-product-id={product.id}
>
  <header class="tb-pick-card__head mb-4 flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-[var(--tb-line)] pb-4">
    <span class="tb-rank">{product.rank}</span>
    {
      product.rank === 1 && (
        <span class="tb-icon-slot tb-icon-slot-pad-16" title="Rank #1" aria-hidden="true">
          <Icon name="product.rank-gold" size={16} />
        </span>
      )
    }
    <h3 class="m-0 min-w-[12rem] flex-[1_1_12rem] tb-h3">
      {productFullName(product)}
    </h3>
    <span class="tb-pill">{product.tag}</span>
    {
      product.thin && (
        <span class="tb-pill tb-pill-thin inline-flex items-center gap-1.5">
          <Icon name="product.thin-evidence" size={16} strokeWidth={2} />
          Limited evidence
        </span>
      )
    }
    <span class="tb-score ms-auto inline-flex items-center gap-1">
      <Icon name="score.total" size={16} class="opacity-70" />
      {product.total.toFixed(1)}
      <small class="text-xs font-normal text-[var(--tb-muted)]">/100</small>
    </span>
  </header>

  <div class="tb-pick-card__main flex flex-col gap-5 lg:grid lg:grid-cols-2 lg:items-start lg:gap-6">
    <div class="tb-pick-card__lead contents lg:flex lg:flex-col lg:gap-4">
      <div class="tb-pick-card__media order-1 lg:order-none">
        <ImageSlot
          slotId={`prod-${product.id}`}
          aspect="square"
          label={`${productFullName(product)} product photo`}
        />
      </div>
      <div class="tb-pick-card__copy order-4 space-y-3 text-sm leading-relaxed lg:order-none">
        {product.X.b && <p class="m-0 text-[var(--tb-ink)]">{product.X.b}</p>}
        <p class="m-0">
          <strong class="text-[var(--tb-heading-muted)]">Best for:</strong>
          {' '}
          {product.best}
        </p>
      </div>
    </div>

    <aside class="tb-pick-card__side order-2 flex flex-col gap-4 lg:order-none">
      <details class="tb-pick-details" data-product-details>
        <summary class="tb-pick-details__summary">
          <Icon name="product.expand" size={16} class="tb-icon-expand shrink-0" />
          Scorecard (7 criteria)
        </summary>
        <div class="tb-pick-details__body tb-pick-details__body--tight space-y-2">
          {
            CRIT.map((c, i) => {
              const critIcon = SCORE_CRIT_ICONS[c[0]] as IconMapKey | undefined;
              return (
                <div class="tb-bar">
                  <span class="inline-flex items-center gap-1.5">
                    {critIcon ? <Icon name={critIcon} size={16} class="opacity-80" /> : null}
                    {c[1].split(' and ')[0]}
                  </span>
                  <span class="tb-bar-track">
                    <i
                      class="tb-bar-fill"
                      style={`width: ${(product.subs[i] ?? 0) * 20}%`}
                      role="img"
                      aria-label={`${c[1]} ${product.subs[i]}/5`}
                    />
                  </span>
                  <span class="tb-num">{product.subs[i]}/5</span>
                </div>
              );
            })
          }
        </div>
      </details>

      <div class="tb-pick-card__price">
        <p class="tb-score m-0 text-3xl leading-none">
          {formatRM(product.price)}
        </p>
        <p class="m-0 mt-1.5 text-xs leading-normal text-[var(--tb-muted)]">
          {product.X.p ?? `as of ${SITE_DATE}`}
        </p>
      </div>

      <div class="tb-pick-card__meta space-y-2 text-sm leading-normal">
        <p class="m-0">
          <strong class="block text-xs font-bold uppercase tracking-wide text-[var(--tb-heading-muted)]">
            After-sales and warranty
          </strong>
          <span>{product.X.a ?? 'Not verified'}</span>
        </p>
        {
          sources.length > 0 && (
            <p class="m-0 flex flex-wrap items-start gap-1.5 text-xs text-[var(--tb-muted)]">
              <Icon name="product.source" size={16} class="mt-0.5 shrink-0" />
              <span>
                Sources:{' '}
                {sources.map((s, idx) => (
                  <>
                    {idx > 0 && '; '}
                    <SourceLink source={s} />
                  </>
                ))}
              </span>
            </p>
          )
        }
      </div>

      <div class="tb-pick-card__actions">
        <div class="tb-pick-card__actions-primary">
          <button type="button" class="tb-btn tb-btn-accent tb-btn-sm" data-aff-placeholder>
            Check price
          </button>
          <a
            href={`/reviews/${product.id}`}
            class="tb-btn tb-btn-ghost tb-btn-sm"
            aria-label={`${fullName} review`}
          >
            {product.brand} review
          </a>
          <a href="/compare" class="tb-btn tb-btn-ghost tb-btn-sm inline-flex items-center justify-center gap-1.5">
            <Icon name="product.compare" size={16} />
            Compare
          </a>
        </div>
        <div class="tb-pick-card__actions-secondary">
          <SaveButton client:idle productId={product.id} />
        </div>
      </div>

      <p class="m-0 text-xs leading-normal text-[var(--tb-muted)]">
        Affiliate link. We may earn a commission.
      </p>
    </aside>

    <details class="tb-pick-details tb-pick-card__specs order-5 lg:col-span-2" data-product-details>
      <summary class="tb-pick-details__summary">
        <Icon name="product.expand" size={16} class="tb-icon-expand shrink-0" />
        Specs, pros and trade-offs
      </summary>
      <div class="tb-pick-details__body">
        <section class="space-y-2">
          <h4 class="tb-pick-details__label">Key specs</h4>
          <ul class="m-0 list-none space-y-1 p-0 text-sm leading-relaxed">
            {
              list.specCols.map((col, i) => (
                <li class="flex gap-2 border-b border-[var(--tb-line)]/60 py-1.5 last:border-0">
                  <span class="min-w-[6.5rem] shrink-0 font-semibold text-[var(--tb-heading-muted)]">
                    {col.replace('*', '')}
                  </span>
                  <span>{product.specs[i] ?? 'n/a'}</span>
                </li>
              ))
            }
          </ul>
        </section>
        <section class="space-y-2">
          <h4 class="tb-pick-details__label flex items-center gap-1.5 text-[var(--color-good)]">
            <Icon name="product.pro" size={16} />
            Pros
          </h4>
          <ul class="tb-pros m-0 space-y-1 pl-5 text-sm leading-relaxed">
            {product.pros.map((x) => <li>{x}</li>)}
          </ul>
        </section>
        <section class="space-y-2">
          <h4 class="tb-pick-details__label flex items-center gap-1.5 text-[var(--tb-accent)]">
            <Icon name="product.con" size={16} />
            Trade-offs
          </h4>
          <ul class="tb-cons m-0 space-y-1 pl-5 text-sm leading-relaxed">
            {product.cons.map((x) => <li>{x}</li>)}
          </ul>
        </section>
      </div>
    </details>
  </div>
</article>