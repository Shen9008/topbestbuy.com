---
import ImageSlot from '../media/ImageSlot.astro';
import SaveButton from '../islands/SaveButton';
import { CRIT } from '../../data/scorecard';
import { SITE_DATE } from '../../data/meta';
import { formatRM, productFullName } from '../../lib/format';
import { resolveSources } from '../../lib/sources';
import type { RankedProduct } from '../../lib/scoring';
import type { ListCatalog } from '../../data/lists';

interface Props {
  product: RankedProduct;
  list: ListCatalog[keyof ListCatalog];
}

const { product, list } = Astro.props;
const sources = resolveSources(product.X.s);
---

<article
  class="tb-card my-4 scroll-mt-32"
  id={product.id}
  data-product-card
  data-product-id={product.id}
>
  <p
    class="mb-3 flex flex-wrap items-center gap-3"
  >
    <span class="tb-rank">{product.rank}</span>
    <h3 class="m-0 min-w-[12rem] flex-1 font-display text-xl font-bold">
      {productFullName(product)}
    </h3>
    <span class="tb-pill">{product.tag}</span>
    {
      product.thin && (
        <span class="tb-pill tb-pill-thin" title="Limited source evidence on key specs">
          Limited evidence
        </span>
      )
    }
    <span class="tb-score">
      {product.total.toFixed(1)}
      <small class="text-xs font-normal text-[var(--tb-muted)]">/100</small>
    </span>
  </p>

  <div class="grid gap-6 lg:grid-cols-2">
    <div>
      <ImageSlot
        slotId={`prod-${product.id}`}
        aspect="square"
        label={`${productFullName(product)} product photo`}
      />
      {product.X.b && <p class="mt-3 text-sm">{product.X.b}</p>}
      <p class="text-sm">
        <strong>Best for:</strong>
        {product.best}
      </p>
      <details class="mt-3 rounded-[var(--radius-sm)] border border-[var(--tb-line)]" open>
        <summary class="cursor-pointer px-4 py-3 font-bold">Specs, pros and trade-offs</summary>
        <div class="px-4 pb-4">
          <p class="mb-2 text-sm font-bold">Key specs</p>
          <ul class="mb-3 text-sm">
            {
              list.specCols.map((col, i) => (
                <li>
                  {col.replace('*', '')}: {product.specs[i] ?? 'n/a'}
                </li>
              ))
            }
          </ul>
          <h4 class="text-sm font-bold text-[var(--color-good)]">Pros</h4>
          <ul class="tb-pros mb-3 text-sm">
            {product.pros.map((x) => <li>{x}</li>)}
          </ul>
          <h4 class="text-sm font-bold text-[var(--tb-accent)]">Trade-offs</h4>
          <ul class="tb-cons text-sm">
            {product.cons.map((x) => <li>{x}</li>)}
          </ul>
        </div>
      </details>
    </div>

    <div>
      <details class="rounded-[var(--radius-sm)] border border-[var(--tb-line)]" open>
        <summary class="cursor-pointer px-4 py-3 font-bold">Scorecard (7 criteria)</summary>
        <div class="space-y-2 px-4 pb-4">
          {
            CRIT.map((c, i) => (
              <div class="tb-bar">
                <span>{c[1].split(' and ')[0]}</span>
                <span class="tb-bar-track">
                  <i
                    class="tb-bar-fill"
                    style={`width: ${(product.subs[i] ?? 0) * 20}%`}
                    role="img"
                    aria-label={`${c[1]} ${product.subs[i]}/5`}
                  />
                </span>
                <span class="tb-num">{product.subs[i]}/5</span>
              </div>
            ))
          }
        </div>
      </details>

      <p class="tb-score mt-4 text-3xl">
        {formatRM(product.price)}
        <small class="block text-xs font-normal text-[var(--tb-muted)]">
          {product.X.p ?? `as of ${SITE_DATE}`}
        </small>
      </p>
      <p class="mt-2 text-sm">
        <strong>After-sales and warranty:</strong>
        {product.X.a ?? 'Not verified'}
      </p>
      {
        sources.length > 0 && (
          <p class="mt-1 text-xs text-[var(--tb-muted)]">
            Sources:{' '}
            {sources.map((s, idx) => (
              <>
                {idx > 0 && '; '}
                <a href={s.href} target="_blank" rel="noopener nofollow" class="underline">
                  {s.title}
                </a>
              </>
            ))}
          </p>
        )
      }

      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" class="tb-btn tb-btn-sm" data-aff-placeholder>
          See price at retailer
        </button>
        <a href={`/reviews/${product.id}`} class="tb-btn tb-btn-ghost tb-btn-sm">
          Full review
        </a>
        <SaveButton client:idle productId={product.id} />
      </div>
      <p class="mt-2 text-xs text-[var(--tb-muted)]">
        Affiliate link. We may earn a commission.
      </p>
    </div>
  </div>
</article>