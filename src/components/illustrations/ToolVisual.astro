---
import VisualWell from './VisualWell.astro';
import { TOOL_VISUAL_IDS, type ToolVisualId } from '../../lib/feature-visuals';

interface Props {
  id: ToolVisualId;
  size?: 'sm' | 'md' | 'lg';
}

const { id, size = 'md' } = Astro.props;
const asset = TOOL_VISUAL_IDS[id];
---

<VisualWell asset={asset} size={size} tone="raised" />