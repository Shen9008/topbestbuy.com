---
import ThemeToggle from '../islands/ThemeToggle.tsx';
import MegaMenu from './MegaMenu.astro';
import SiteLogo from './SiteLogo.astro';

const path = Astro.url.pathname;
---

<header
  class="sticky top-0 z-[var(--z-sticky)] border-b border-[var(--tb-line)] bg-[var(--tb-bg)]/90 backdrop-blur-md lg:pl-[var(--rail-width)]"
>
  <div
    class="relative mx-auto flex h-[var(--topbar-height)] max-w-[var(--content-max)] items-center gap-3 px-4"
  >
    <SiteLogo variant="full" class="lg:hidden" />
    <MegaMenu currentPath={path} />
    <nav class="hidden items-center gap-1 xl:flex" aria-label="Primary">
      <a href="/categories" class="rounded-lg px-3 py-2 text-sm font-semibold text-[var(--tb-ink)] hover:bg-[var(--tb-surface)]">Lists</a>
      <a href="/tools" class="rounded-lg px-3 py-2 text-sm font-semibold text-[var(--tb-ink)] hover:bg-[var(--tb-surface)]">Tools</a>
      <a href="/guides" class="rounded-lg px-3 py-2 text-sm font-semibold text-[var(--tb-ink)] hover:bg-[var(--tb-surface)]">Guides</a>
      <a href="/how-we-rank" class="rounded-lg px-3 py-2 text-sm font-semibold text-[var(--tb-ink)] hover:bg-[var(--tb-surface)]">How we rank</a>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <button
        type="button"
        id="open-search"
        class="inline-flex min-h-10 min-w-10 cursor-pointer items-center justify-center rounded-[var(--radius-sm)] border border-[var(--tb-line)] bg-[var(--tb-surface)] text-[var(--tb-ink)]"
        aria-label="Search the site"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </button>
      <button
        type="button"
        id="open-shortlist"
        class="inline-flex min-h-10 cursor-pointer items-center gap-1 rounded-[var(--radius-sm)] border border-[var(--tb-line)] bg-[var(--tb-surface)] px-2 text-[var(--tb-ink)]"
        aria-label="Open my shortlist"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M12 21s-7-4.6-9.3-9A5.3 5.3 0 0 1 12 6a5.3 5.3 0 0 1 9.3 6c-2.3 4.4-9.3 9-9.3 9z"/></svg>
        <span class="text-xs font-bold">Saved</span>
      </button>
      <ThemeToggle client:load />
    </div>
  </div>
</header>

<script is:inline>
  document.getElementById('open-search')?.addEventListener('click', () => {
    window.dispatchEvent(new Event('tb-open-search'));
  });
  document.getElementById('open-shortlist')?.addEventListener('click', () => {
    window.dispatchEvent(new Event('tb-open-shortlist'));
  });
</script>