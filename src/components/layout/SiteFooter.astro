---
import { CATS } from '../../data/categories';
import { LISTS } from '../../data/lists';
import { TRUST_ROUTES } from '../../lib/routes';
import { TRUST_ROUTE_ICONS, LIST_SLUG_ICONS, type IconMapKey } from '../../icons';
import Icon from '../ui/Icon.astro';
import SiteLogo from './SiteLogo.astro';

const liveLists = CATS.flatMap((c) => c.lists).slice(0, 6);

const trustLinks = [
  ...TRUST_ROUTES.map((route) => ({ ...route, icon: TRUST_ROUTE_ICONS[route.href] })),
  { href: '/how-we-rank', label: 'How we rank', icon: TRUST_ROUTE_ICONS['/how-we-rank'] },
];
---

<footer
  class="border-t border-[var(--tb-line)] bg-[var(--tb-surface)] pb-[calc(var(--tabbar-height)+1rem)] text-sm lg:pb-8"
>
  <div class="mx-auto grid max-w-[var(--content-max)] gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <SiteLogo variant="full" />
      <p class="mt-2 max-w-[30ch] text-[var(--tb-muted)]">
        Ten picks, clear reasons, no hype. Desk research, dated sources, published scoring.
      </p>
    </div>
    <div>
      <p class="font-semibold uppercase tracking-wide text-[var(--tb-muted)]">Top 10 lists</p>
      <ul class="mt-3 list-none space-y-2 p-0">
        {
          liveLists.map((slug) => {
            const icon = LIST_SLUG_ICONS[slug];
            return (
              <li>
                <a
                  href={`/${slug}`}
                  class="inline-flex items-center gap-2 text-[var(--tb-ink)] transition-colors duration-150 hover:text-[var(--tb-accent)]"
                >
                  {icon ? <Icon name={icon} size={16} class="opacity-80" /> : null}
                  Best {LISTS[slug as keyof typeof LISTS].short.toLowerCase()}
                </a>
              </li>
            );
          })
        }
        <li>
          <a href="/categories" class="inline-flex items-center gap-2 font-semibold">
            <Icon name="category.all" size={16} />
            All categories
          </a>
        </li>
      </ul>
    </div>
    <div>
      <p class="font-semibold uppercase tracking-wide text-[var(--tb-muted)]">Tools</p>
      <ul class="mt-3 list-none space-y-2 p-0">
        <li><a href="/tools?tool=finder">Product finder</a></li>
        <li><a href="/tools?tool=airfryer">Air fryer size</a></li>
        <li><a href="/tools?tool=purifier">Purifier room size</a></li>
        <li><a href="/tools?tool=vacuum">Vacuum chooser</a></li>
        <li><a href="/tools?tool=cleanser">Cleanser matcher</a></li>
        <li>
          <a href="/compare" class="inline-flex items-center gap-2">
            <Icon name="tool.compare" size={16} />
            Compare products
          </a>
        </li>
      </ul>
    </div>
    <div>
      <p class="font-semibold uppercase tracking-wide text-[var(--tb-muted)]">Trust</p>
      <ul class="mt-3 list-none space-y-2 p-0">
        <li>
          <a href="/trust" class="font-semibold">Trust centre</a>
        </li>
        {
          trustLinks.map((route) => {
            const icon = route.icon as IconMapKey | undefined;
            return (
              <li>
                <a
                  href={route.href}
                  class="inline-flex items-center gap-2 transition-colors duration-150 hover:text-[var(--tb-accent)]"
                >
                  {icon ? <Icon name={icon} size={20} class="opacity-80" /> : null}
                  {route.label}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-[var(--content-max)] border-t border-[var(--tb-line)] px-4 py-4 text-xs text-[var(--tb-muted)]">
    <p>
      Some links are affiliate links. We may earn a commission at no extra cost to you. It never
      changes our rankings. © {new Date().getFullYear()} TopBestBuy · topbestbuy.online
    </p>
  </div>
</footer>