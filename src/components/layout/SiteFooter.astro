---
import { CATS } from '../../data/categories';
import { LISTS } from '../../data/lists';
import { TRUST_ROUTES } from '../../lib/routes';

const liveLists = CATS.flatMap((c) => c.lists).slice(0, 6);
---

<footer
  class="border-t border-[var(--tb-line)] bg-[var(--tb-surface)] pb-[calc(var(--tabbar-height)+1rem)] text-sm lg:pb-8 lg:pl-[var(--rail-width)]"
>
  <div class="mx-auto grid max-w-[var(--content-max)] gap-8 px-4 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div>
      <p class="font-display text-lg font-extrabold text-[var(--tb-ink)]">
        TopBestBuy<span class="ml-1 text-xs text-[var(--tb-accent)]">10</span>
      </p>
      <p class="mt-2 max-w-[30ch] text-[var(--tb-muted)]">
        Ten picks, clear reasons, no hype. Desk research, dated sources, published scoring.
      </p>
    </div>
    <div>
      <p class="font-semibold uppercase tracking-wide text-[var(--tb-muted)]">Top 10 lists</p>
      <ul class="mt-3 list-none space-y-2 p-0">
        {
          liveLists.map((slug) => (
            <li>
              <a href={`/${slug}`} class="text-[var(--tb-ink)] hover:text-[var(--tb-accent)]">
                Best {LISTS[slug as keyof typeof LISTS].short.toLowerCase()}
              </a>
            </li>
          ))
        }
        <li>
          <a href="/categories">All categories</a>
        </li>
      </ul>
    </div>
    <div>
      <p class="font-semibold uppercase tracking-wide text-[var(--tb-muted)]">Tools</p>
      <ul class="mt-3 list-none space-y-2 p-0">
        <li><a href="/tools?tool=finder">Product finder</a></li>
        <li><a href="/tools?tool=airfryer">Air fryer size</a></li>
        <li><a href="/tools?tool=purifier">Purifier room size</a></li>
        <li><a href="/compare">Compare products</a></li>
      </ul>
    </div>
    <div>
      <p class="font-semibold uppercase tracking-wide text-[var(--tb-muted)]">Trust</p>
      <ul class="mt-3 list-none space-y-2 p-0">
        {
          TRUST_ROUTES.map((route) => (
            <li>
              <a href={route.href}>{route.label}</a>
            </li>
          ))
        }
        <li><a href="/how-we-rank">How we rank</a></li>
      </ul>
    </div>
  </div>
  <div class="mx-auto max-w-[var(--content-max)] border-t border-[var(--tb-line)] px-4 py-4 text-xs text-[var(--tb-muted)]">
    <p>
      Some links are affiliate links. We may earn a commission at no extra cost to you. It never
      changes our rankings. © {new Date().getFullYear()} TopBestBuy · topbestbuy.online
    </p>
  </div>
</footer>