---
import Icon from '../ui/Icon.astro';
import ListVisual from '../ui/ListVisual.astro';
import { CATS } from '../../data/categories';
import { LISTS } from '../../data/lists';
import { hasListVisual } from '../../lib/list-visuals';
import { CATEGORY_ICONS, type IconMapKey } from '../../icons';
---

<div class="relative hidden md:block xl:hidden">
  <button
    type="button"
    id="mega-trigger"
    class="inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-[var(--radius-pill)] border border-[var(--tb-line)] bg-[var(--tb-surface)] px-4 py-2 text-sm font-semibold text-[var(--tb-ink)] transition-[color,border-color] duration-150 hover:border-[var(--accent-line)]"
    aria-expanded="false"
    aria-controls="mega-panel"
  >
    Browse categories
    <Icon name="nav.mega-chevron" size={16} strokeWidth={2} decorative />
  </button>
  <div
    id="mega-panel"
    class="absolute left-0 top-[calc(100%+0.5rem)] z-[var(--z-dropdown)] hidden w-[min(100vw-2rem,52rem)] rounded-[var(--radius-lg)] border border-[var(--tb-line)] bg-[var(--tb-surface-raised)] p-4 shadow-lg"
    role="region"
    aria-label="Top 10 lists"
    hidden
  >
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        CATS.filter((c) => c.lists.length).map((c) => {
          const catIcon = CATEGORY_ICONS[c.id] as IconMapKey | undefined;
          return (
            <div>
              <h4 class="m-0 flex items-center gap-2 tb-h4">
                {catIcon ? (
                  <span class="tb-icon-slot tb-icon-slot-pad-16" aria-hidden="true">
                    <Icon name={catIcon} size={32} />
                  </span>
                ) : null}
                <a href={`/category/${c.id}`}>{c.name}</a>
              </h4>
              <ul class="m-0 mt-2 list-none space-y-1 p-0 text-sm">
                {c.lists.map((slug) => (
                    <li>
                      <a
                        href={`/${slug}`}
                        class="inline-flex items-center gap-2 text-[var(--tb-ink)] transition-colors duration-150 hover:text-[var(--tb-accent-fg)]"
                      >
                        {hasListVisual(slug) ? (
                          <ListVisual slug={slug} size="sm" class="tb-visual-well--compact" />
                        ) : null}
                        {LISTS[slug as keyof typeof LISTS].short}
                      </a>
                    </li>
                  ))}
              </ul>
            </div>
          );
        })
      }
    </div>
    <p class="mb-0 mt-3 flex flex-wrap items-center gap-2 text-sm">
      <a href="/categories" class="inline-flex items-center gap-1.5 font-semibold">
        <Icon name="category.all" size={16} />
        All categories
      </a>
      <span aria-hidden="true">·</span>
      <a href="/coming-next">Vote for the next list</a>
      <span aria-hidden="true">·</span>
      <a href="/tools">Buying tools</a>
    </p>
  </div>
</div>

<script is:inline>
  const trigger = document.getElementById('mega-trigger');
  const panel = document.getElementById('mega-panel');
  if (trigger && panel) {
    trigger.addEventListener('click', (e) => {
      e.stopPropagation();
      const open = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!open));
      panel.hidden = open;
      panel.classList.toggle('hidden', open);
    });
    document.addEventListener('click', () => {
      trigger.setAttribute('aria-expanded', 'false');
      panel.hidden = true;
      panel.classList.add('hidden');
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && trigger.getAttribute('aria-expanded') === 'true') {
        trigger.setAttribute('aria-expanded', 'false');
        panel.hidden = true;
        panel.classList.add('hidden');
        trigger.focus();
      }
    });
  }
</script>