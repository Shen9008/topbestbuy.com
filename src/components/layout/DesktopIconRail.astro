---
const links = [
  { href: '/', label: 'Home' },
  { href: '/search', label: 'Search' },
  { href: '/category/kitchen', label: 'Categories' },
  { href: '/saved', label: 'Saved' },
  { href: '/tools', label: 'Tools' },
] as const;

const iconPaths: Record<string, string> = {
  Home: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-9.5Z',
  Search:
    'm21 21-4.35-4.35M11 18a7 7 0 1 1 0-14 7 7 0 0 1 0 14Z',
  Categories:
    'M4 4h7v7H4V4Zm9 0h7v7h-7V4ZM4 13h7v7H4v-7Zm9 0h7v7h-7v-7Z',
  Saved: 'M6 4h12v16l-6-4-6 4V4Z',
  Tools:
    'M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z',
};

function isActive(href: string) {
  const path = Astro.url.pathname;
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<nav
  class="fixed bottom-[var(--tabbar-height)] left-0 top-0 z-[var(--z-rail)] hidden w-[var(--rail-width)] flex-col items-center gap-2 border-r border-[var(--tb-line)] bg-[var(--tb-surface)] py-4 lg:flex"
  aria-label="Primary"
>
  <a
    href="/"
    class="mb-4 flex h-10 w-10 items-center justify-center rounded-[var(--radius-md)] bg-[var(--tb-accent)] font-display text-sm font-bold text-[var(--tb-accent-ink)]"
  >
    TB
  </a>
  {
    links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'flex w-full flex-col items-center gap-1 px-1 py-2 text-[0.65rem] font-medium transition-colors',
          isActive(link.href)
            ? 'text-[var(--tb-accent)]'
            : 'text-[var(--tb-muted)] hover:text-[var(--tb-ink)]',
        ]}
        aria-current={isActive(link.href) ? 'page' : undefined}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path d={iconPaths[link.label]} />
        </svg>
        <span>{link.label}</span>
      </a>
    ))
  }
</nav>