---
import Icon from '../ui/Icon.astro';
import SiteLogo from './SiteLogo.astro';
import type { IconMapKey } from '../../icons';

const links: { href: string; label: string; icon: IconMapKey }[] = [
  { href: '/', label: 'Home', icon: 'nav.home' },
  { href: '/search', label: 'Search', icon: 'nav.search' },
  { href: '/category/kitchen', label: 'Categories', icon: 'nav.categories' },
  { href: '/saved', label: 'Saved', icon: 'nav.saved' },
  { href: '/tools', label: 'Tools', icon: 'nav.tools' },
];

function isActive(href: string) {
  const path = Astro.url.pathname;
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<nav
  class="fixed bottom-[var(--tabbar-height)] left-0 top-0 z-[var(--z-rail)] hidden w-[var(--rail-width)] flex-col items-center gap-2 border-r border-[var(--tb-line)] bg-[var(--tb-surface)] py-4 lg:flex"
  aria-label="Primary"
>
  <SiteLogo variant="mark" class="mb-4" />
  {
    links.map((link) => (
      <a
        href={link.href}
        class:list={[
          'flex w-full min-h-11 flex-col items-center justify-center gap-1 px-1 py-2 text-[0.65rem] font-medium transition-colors duration-150',
          isActive(link.href)
            ? 'text-[var(--tb-accent)]'
            : 'text-[var(--tb-muted)] hover:text-[var(--tb-accent)]',
        ]}
        aria-current={isActive(link.href) ? 'page' : undefined}
      >
        <Icon name={link.icon} size={24} />
        <span>{link.label}</span>
      </a>
    ))
  }
</nav>