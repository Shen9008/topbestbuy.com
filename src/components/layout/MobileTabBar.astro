---
import Icon from '../ui/Icon.astro';
import { MOBILE_TABS } from '../../lib/routes';
import { NAV_ICON_NAMES, type IconName } from '../../icons';

function tabIcon(key: (typeof MOBILE_TABS)[number]['icon']): IconName {
  return NAV_ICON_NAMES[key];
}

function isActive(href: string) {
  const path = Astro.url.pathname;
  if (href === '/') return path === '/';
  if (href.startsWith('/category')) {
    return path.startsWith('/category');
  }
  return path === href || path.startsWith(`${href}/`);
}
---

<nav
  class="fixed bottom-0 left-0 right-0 z-[var(--z-tabbar)] border-t border-[var(--tb-line)] bg-[var(--tb-surface)]/95 backdrop-blur-md lg:hidden"
  aria-label="Mobile primary"
>
  <ul class="grid h-[var(--tabbar-height)] grid-cols-5">
    {
      MOBILE_TABS.map((tab) => (
        <li>
          <a
            href={tab.href}
            class:list={[
              'flex h-full min-h-11 cursor-pointer flex-col items-center justify-center gap-0.5 text-[0.65rem] font-medium transition-colors',
              isActive(tab.href)
                ? 'text-[var(--tb-accent)]'
                : 'text-[var(--tb-muted)]',
            ]}
            aria-current={isActive(tab.href) ? 'page' : undefined}
          >
            <Icon name={tabIcon(tab.icon)} size={22} />
            {tab.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>