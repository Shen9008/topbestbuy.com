---
import ImageSlot from '../media/ImageSlot.astro';

export interface Props {
  title: string;
  kicker?: string;
  description?: string;
  showHeroImage?: boolean;
}

const {
  title,
  kicker = 'Phase 1 stub',
  description = 'Content and scoring data arrive in Phase 2 onward. This shell confirms routing and layout only.',
  showHeroImage = true,
} = Astro.props;
---

<article class="space-y-6">
  <header class="space-y-3">
    <p class="text-sm font-semibold text-[var(--tb-accent)]">{kicker}</p>
    <h1 class="tb-h1">
      {title}
    </h1>
    <p class="text-base text-[var(--tb-muted)]">{description}</p>
  </header>
  {
    showHeroImage && (
      <ImageSlot slotId="hero-stub" aspect="banner" label="Hero image placeholder" />
    )
  }
  <div
    class="rounded-[var(--radius-lg)] border border-dashed border-[var(--tb-line)] bg-[var(--tb-surface)] p-6 text-sm text-[var(--tb-muted)]"
  >
    <slot />
  </div>
</article>