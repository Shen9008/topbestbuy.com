---
import ValueVisual from '../illustrations/ValueVisual.astro';
import SectionHeader from './SectionHeader.astro';
import type { ValueVisualId } from '../../lib/feature-visuals';

const items: { step: string; visual: ValueVisualId; title: string; copy: string }[] = [
  { step: '01', visual: 'pick', title: 'Pick in 30 seconds', copy: 'Top 3 summary, then ten scored picks.' },
  { step: '02', visual: 'tradeoffs', title: 'Know the trade-offs', copy: 'Every pick lists what it does badly.' },
  { step: '03', visual: 'malaysia', title: 'Built for Malaysia', copy: 'MYR prices, local warranty notes, local retailers.' },
];
---

<section class="tb-section tb-section--editorial" aria-labelledby="home-value-heading">
  <SectionHeader
    titleId="home-value-heading"
    align="center"
    eyebrow="Why TopBestBuy"
    title="Research you can scan in a minute"
    description="No hype: scored lists, dated prices, and the downsides we found."
  />
  <div class="tb-feature-grid tb-reveal-stagger mt-8">
    {
      items.map((item) => (
        <article class="tb-value-card">
          <div class="tb-value-card__head">
            <span class="tb-value-card__step">{item.step}</span>
            <span class="tb-value-card__icon" aria-hidden="true">
              <ValueVisual id={item.visual} size="lg" />
            </span>
          </div>
          <h3 class="m-0 font-display text-base font-bold">{item.title}</h3>
          <p class="m-0 text-sm leading-relaxed text-[var(--tb-muted)]">{item.copy}</p>
        </article>
      ))
    }
  </div>
</section>
