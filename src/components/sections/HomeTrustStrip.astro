---
import TrustVisual from '../illustrations/TrustVisual.astro';
import type { TrustVisualId } from '../../lib/feature-visuals';

const items: { visual: TrustVisualId; label: string; href: string }[] = [
  { visual: 'no-paid', label: 'No paid rankings', href: '/editorial-policy' },
  { visual: 'dated', label: 'Dated prices and sources', href: '/how-we-rank' },
  { visual: 'scorecard', label: 'Scorecard published', href: '/how-we-rank' },
  { visual: 'log', label: 'Corrections log', href: '/corrections' },
];
---

<section class="tb-band tb-band--alt tb-trust-strip border-y-0 py-10" aria-label="Editorial independence">
  <div class="tb-section__inner">
  <div class="tb-trust-strip__grid tb-reveal-stagger">
    {
      items.map((item) => (
        <a href={item.href} class="tb-trust-pill no-underline">
          <span class="tb-trust-pill__icon" aria-hidden="true">
            <TrustVisual id={item.visual} size="sm" />
          </span>
          <span>{item.label}</span>
        </a>
      ))
    }
  </div>
  </div>
</section>
