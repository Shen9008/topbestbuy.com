---
import MethodologyStepVisual from '../illustrations/MethodologyStepVisual.astro';
import TrustVisual from '../illustrations/TrustVisual.astro';
import type { MethodologyStepVisualId, TrustVisualId } from '../../lib/feature-visuals';

type Item =
  | { kind: 'method'; visual: MethodologyStepVisualId; title: string; copy: string; detail?: string }
  | { kind: 'trust'; visual: TrustVisualId; title: string; copy: string; detail?: string };

const items: Item[] = [
  {
    kind: 'method',
    visual: 'research',
    title: 'Researched, not tested',
    copy: 'We read specs, retailers and expert reviews.',
  },
  {
    kind: 'trust',
    visual: 'dated',
    title: 'Dated, sourced prices',
    copy: 'Verify at checkout.',
    detail: 'MYR as reported',
  },
  {
    kind: 'trust',
    visual: 'scorecard',
    title: 'Seven weighted criteria',
    copy: 'Published on every card.',
    detail: 'Scorecard v1.0',
  },
];
---

<div class="tb-methodology-strip tb-reveal-stagger" aria-label="How this list was built">
  {
    items.map((item) => (
      <article class="tb-methodology-card">
        <span class="tb-methodology-card__icon" aria-hidden="true">
          {item.kind === 'method' ? (
            <MethodologyStepVisual id={item.visual} size="md" />
          ) : (
            <TrustVisual id={item.visual} size="md" />
          )}
        </span>
        <div>
          <h3 class="m-0 font-display text-base font-bold">{item.title}</h3>
          <p class="m-0 mt-1 text-sm text-[var(--tb-muted)]">{item.copy}</p>
          {item.detail ? (
            <p class="m-0 mt-2 flex items-center gap-2 text-xs font-semibold text-[var(--tb-ink)]">
              <span class="tb-check-mark" aria-hidden="true" />
              {item.detail}
            </p>
          ) : null}
        </div>
      </article>
    ))
  }
</div>