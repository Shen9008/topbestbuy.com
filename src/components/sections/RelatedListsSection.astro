---
import SectionHeader from './SectionHeader.astro';
import type { ListLink } from '../../lib/internal-links';

interface Props {
  categoryName: string;
  categoryHref: string;
  lists: ListLink[];
}

const { categoryName, categoryHref, lists } = Astro.props;
---

{
  lists.length > 0 && (
    <section class="mt-10" aria-labelledby="related-lists-heading">
      <SectionHeader
        titleId="related-lists-heading"
        title={`More ${categoryName.toLowerCase()} lists`}
        seeAllHref={categoryHref}
        seeAllLabel={`${categoryName} hub`}
      />
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {lists.map((item) => (
          <a href={`/${item.slug}`} class="tb-tile tb-card--editorial no-underline">
            <span class="text-xs font-bold uppercase text-[var(--tb-muted)]">{item.short}</span>
            <strong class="mt-1 block text-[var(--tb-ink)]">{item.h1.split(':')[0]}</strong>
          </a>
        ))}
      </div>
    </section>
  )
}