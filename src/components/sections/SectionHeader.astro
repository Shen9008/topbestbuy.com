---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  titleId?: string;
  seeAllHref?: string;
  seeAllLabel?: string;
  class?: string;
}

const {
  eyebrow,
  title,
  description,
  align = 'center',
  titleId,
  seeAllHref,
  seeAllLabel = 'See all',
  class: className = '',
} = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto max-w-[40ch]' : 'max-w-[52ch]';
const barClass = align === 'center' ? 'justify-center' : '';
---

<div class:list={['tb-section__bar', barClass, className]}>
  <header class:list={['tb-section__head', alignClass]}>
    {eyebrow ? (
      <p class="m-0 text-xs font-bold uppercase tracking-[0.14em] text-[var(--tb-muted)]">{eyebrow}</p>
    ) : null}
    <h2 id={titleId} class="m-0 mt-2 tb-h2">
      {title}
    </h2>
    {description ? <p class="m-0 mt-2 text-sm text-[var(--tb-muted)] sm:text-base">{description}</p> : null}
  </header>
  {
    seeAllHref ? (
      <a href={seeAllHref} class="tb-section-link shrink-0">
        {seeAllLabel}
      </a>
    ) : null
  }
</div>
