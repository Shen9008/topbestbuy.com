---
interface Props {
  band?: 'default' | 'alt' | 'navy' | 'auto' | 'none';
  class?: string;
  id?: string;
  'aria-labelledby'?: string;
  'aria-label'?: string;
}

const {
  band = 'none',
  class: className = '',
  id,
  'aria-labelledby': ariaLabelledby,
  'aria-label': ariaLabel,
} = Astro.props;

const bandClass =
  band === 'default'
    ? 'tb-band'
    : band === 'alt' || band === 'navy'
      ? 'tb-band tb-band--navy'
      : band === 'auto'
        ? 'tb-page-bands__section'
        : 'tb-section tb-section--editorial';
const motionClass = band !== 'none' ? 'tb-reveal' : '';
---

<section
  id={id}
  class:list={[bandClass, motionClass, className]}
  aria-labelledby={ariaLabelledby}
  aria-label={ariaLabel}
>
  <div class="tb-section__inner">
    <slot />
  </div>
</section>