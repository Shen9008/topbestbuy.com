---
import RankedProductRow from '../list/RankedProductRow.astro';
import type { RankedProduct } from '../../lib/scoring';

interface Props {
  rows: RankedProduct[];
  listShort: string;
}

const { rows, listShort } = Astro.props;
const top = rows.slice(0, 5);
---

{
  top.length > 0 && (
    <nav
      class="tb-editorial-center not-prose mt-4 rounded-[var(--radius-md)] border border-[var(--tb-line)] bg-[var(--tb-surface-raised)] p-4"
      aria-label="Top review pages"
    >
      <p class="m-0 text-xs font-bold uppercase tracking-[0.12em] text-[var(--tb-muted)]">
        Full reviews · {listShort}
      </p>
      <div class="tb-editorial-scan mt-2 grid gap-2 text-left">
        {top.map((p) => (
          <RankedProductRow product={p} href={`/reviews/${p.id}`} detail={p.tag} />
        ))}
      </div>
    </nav>
  )
}