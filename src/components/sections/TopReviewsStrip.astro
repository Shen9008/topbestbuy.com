---
import { productFullName } from '../../lib/format';
import type { RankedProduct } from '../../lib/scoring';

interface Props {
  rows: RankedProduct[];
  listShort: string;
}

const { rows, listShort } = Astro.props;
const top = rows.slice(0, 3);
---

{
  top.length > 0 && (
    <nav class="not-prose mt-4 rounded-[var(--radius-md)] border border-[var(--tb-line)] bg-[var(--tb-surface-raised)] p-4" aria-label="Top review pages">
      <p class="m-0 text-xs font-bold uppercase tracking-[0.12em] text-[var(--tb-muted)]">
        Full reviews · {listShort}
      </p>
      <ul class="m-0 mt-2 list-none space-y-1 p-0 text-sm">
        {top.map((p) => (
          <li>
            <a href={`/reviews/${p.id}`} class="font-semibold text-[var(--tb-accent-fg)] no-underline hover:text-[var(--tb-ink)]">
              <span class="tb-num text-xs">#{p.rank}</span> {productFullName(p)}
            </a>
            <span class="tb-num text-[var(--tb-muted)]"> · {p.total.toFixed(1)}/100</span>
          </li>
        ))}
      </ul>
    </nav>
  )
}