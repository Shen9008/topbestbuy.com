---
import SectionHeader from './SectionHeader.astro';
import GuideCard from './GuideCard.astro';
import { FEATURED_GUIDES } from '../../lib/guide-banners';
---

<section class="tb-page-bands__section" aria-labelledby="home-guides-heading">
  <div class="tb-section__inner">
    <SectionHeader
      titleId="home-guides-heading"
      title="Guides and explainers"
      align="left"
      seeAllHref="/guides"
      seeAllLabel="See all guides"
    />
    <div class="tb-guide-grid tb-reveal-stagger">
      {FEATURED_GUIDES.map((id) => <GuideCard id={id} />)}
    </div>
  </div>
</section>
