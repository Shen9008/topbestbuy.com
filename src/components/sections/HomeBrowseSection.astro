---
import Icon from '../ui/Icon.astro';
import ListVisual from '../ui/ListVisual.astro';
import { hasListVisual } from '../../lib/list-visuals';
import SectionHeader from './SectionHeader.astro';
import { CATS } from '../../data/categories';
import { LISTS } from '../../data/lists';
import { listSlugs, topPick, type ListSlug } from '../../lib/catalog';
import { productFullName } from '../../lib/format';
import { rankingCardBanner } from '../../lib/ranking-card-banners';
import { CATEGORY_ICONS, type IconMapKey } from '../../icons';

interface Props {
  bare?: boolean;
}

const { bare = false } = Astro.props;
const Tag = bare ? 'div' : 'section';
const sectionClass = bare ? '' : 'tb-section';
---

<Tag class={sectionClass} aria-labelledby="home-browse-heading">
  <SectionHeader
    titleId="home-browse-heading"
    eyebrow="Browse"
    title="What are you shopping for?"
    seeAllHref="/categories"
    seeAllLabel="All categories"
  />
  <div class="tb-scroll-strip mt-4 lg:flex lg:flex-wrap lg:overflow-visible lg:pb-0">
    {
      CATS.map((c) => {
        const icon = CATEGORY_ICONS[c.id] as IconMapKey | undefined;
        return (
          <a href={`/category/${c.id}`} class="tb-chip inline-flex items-center gap-1.5">
            {icon ? <Icon name={icon} size={20} /> : null}
            {c.name}
            {c.lists.length ? ` (${c.lists.length})` : ''}
          </a>
        );
      })
    }
  </div>
  <SectionHeader
    class="mt-12"
    titleId="home-lists-heading"
    title="Start with a list"
    description="Every card opens a dated Top 10 with sources and trade-offs."
    seeAllHref="/categories"
    seeAllLabel="See all lists"
  />
  <div class="tb-ranking-grid tb-reveal-stagger mt-6">
    {
      listSlugs().map((slug) => {
        const L = LISTS[slug as keyof typeof LISTS];
        const p = topPick(slug);
        const banner = rankingCardBanner(slug as ListSlug, p?.id);
        return (
          <a href={`/${slug}`} class="tb-ranking-card">
            {banner ? (
              <img
                class="tb-ranking-card__banner"
                src={banner}
                width="800"
                height="450"
                alt=""
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="tb-ranking-card__banner tb-ranking-card__banner--fallback" aria-hidden="true">
                {hasListVisual(slug) && <ListVisual slug={slug} size="md" />}
              </div>
            )}
            <div class="tb-ranking-card__body">
              <p class="m-0 text-xs font-semibold text-[var(--tb-muted)]">
                {CATS.find((c) => c.id === L.cat)?.name}
              </p>
              <h3 class="tb-ranking-card__title">{L.short}: Top 10 in Malaysia</h3>
              {p && (
                <p class="m-0 mt-3 text-sm text-[var(--tb-muted)]">
                  #1 {productFullName(p)}{' '}
                  <span class="tb-num font-semibold text-[var(--tb-ink)]">({p.total.toFixed(1)}/100)</span>
                </p>
              )}
              {L.kw && (
                <span class="mt-auto pt-3 text-xs text-[var(--tb-muted)]">
                  About{' '}
                  <span class="tb-num font-medium text-[var(--tb-ink)]">
                    {L.kw[1].toLocaleString('en-MY')}
                  </span>{' '}
                  searches a month for &ldquo;{L.kw[0]}&rdquo; (Semrush, Malaysia)
                </span>
              )}
            </div>
          </a>
        );
      })
    }
  </div>
</Tag>
