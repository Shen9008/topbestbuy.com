---
import Icon from './Icon.astro';
---

<button
  type="button"
  id="tb-back-to-top"
  class="tb-icon-slot tb-icon-slot--hover tb-icon-slot-pad-20 fixed bottom-[calc(var(--tabbar-height)+1rem)] right-4 z-[var(--z-sticky)] hidden cursor-pointer rounded-full shadow-md lg:bottom-6"
  aria-label="Back to top"
  title="Back to top"
>
  <Icon name="nav.back-to-top" size={20} />
</button>

<script>
  const btn = document.getElementById('tb-back-to-top');
  if (btn) {
    const toggle = () => {
      const show = window.scrollY > 480;
      btn.classList.toggle('hidden', !show);
      btn.classList.toggle('inline-flex', show);
    };
    toggle();
    window.addEventListener('scroll', toggle, { passive: true });
    btn.addEventListener('click', () => {
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduced ? 'auto' : 'smooth' });
    });
  }
</script>