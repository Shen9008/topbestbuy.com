---
import {
  DEFAULT_STROKE_WIDTH,
  getIconNodes,
  defaultIconSize,
  ICON_SIZES,
  type IconMapKey,
  type IconSize,
} from '../../icons';

interface Props {
  name: IconMapKey;
  size?: IconSize;
  strokeWidth?: number;
  class?: string;
  decorative?: boolean;
  label?: string;
  spin?: boolean;
}

const {
  name,
  size = defaultIconSize(name) as IconSize,
  strokeWidth = DEFAULT_STROKE_WIDTH,
  class: className,
  decorative = true,
  label,
  spin = false,
} = Astro.props;

if (!decorative && !label) {
  throw new Error(`Icon "${name}" with decorative={false} requires a label.`);
}
if (size !== undefined && !(ICON_SIZES as readonly number[]).includes(size)) {
  throw new Error(`Icon size must be one of ${ICON_SIZES.join(', ')}.`);
}

const nodes = getIconNodes(name);
const isLoader = name === 'state.loading';
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={[
    'tb-icon',
    spin || isLoader ? 'tb-icon-spin' : undefined,
    className,
  ]}
  aria-hidden={decorative ? 'true' : undefined}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : label}
>
  {
    nodes.map(([tag, attrs]) => {
      switch (tag) {
        case 'path':
          return <path {...attrs} />;
        case 'circle':
          return <circle {...attrs} />;
        case 'rect':
          return <rect {...attrs} />;
        case 'line':
          return <line {...attrs} />;
        case 'polyline':
          return <polyline {...attrs} />;
        case 'polygon':
          return <polygon {...attrs} />;
        case 'ellipse':
          return <ellipse {...attrs} />;
        default:
          return null;
      }
    })
  }
</svg>