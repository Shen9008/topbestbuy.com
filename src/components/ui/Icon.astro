---
import {
  DEFAULT_STROKE_WIDTH,
  getIconNodes,
  type IconName,
} from '../../icons';

interface Props {
  name: IconName;
  size?: number;
  strokeWidth?: number;
  class?: string;
  decorative?: boolean;
}

const {
  name,
  size = 24,
  strokeWidth = DEFAULT_STROKE_WIDTH,
  class: className,
  decorative = true,
} = Astro.props;

const nodes = getIconNodes(name);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['tb-icon', className]}
  aria-hidden={decorative ? 'true' : undefined}
>
  {
    nodes.map(([tag, attrs]) => {
      switch (tag) {
        case 'path':
          return <path {...attrs} />;
        case 'circle':
          return <circle {...attrs} />;
        case 'rect':
          return <rect {...attrs} />;
        case 'line':
          return <line {...attrs} />;
        case 'polyline':
          return <polyline {...attrs} />;
        case 'polygon':
          return <polygon {...attrs} />;
        case 'ellipse':
          return <ellipse {...attrs} />;
        default:
          return null;
      }
    })
  }
</svg>