---
import VisualWell from '../illustrations/VisualWell.astro';
import { LIST_VISUAL_BY_SLUG } from '../../lib/list-visuals';

interface Props {
  slug: string;
  size?: 'sm' | 'md';
  class?: string;
}

const { slug, size = 'sm', class: className } = Astro.props;
const visualId = LIST_VISUAL_BY_SLUG[slug];
if (!visualId) return;

const wellSize = size === 'md' ? 'md' : 'sm';
---

<VisualWell asset={visualId} size={wellSize} class={className} />