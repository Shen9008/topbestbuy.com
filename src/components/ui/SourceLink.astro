---
import type { SourceLink as SourceLinkType } from '../../lib/sources';

interface Props {
  source: SourceLinkType;
  class?: string;
}

const { source, class: className } = Astro.props;
---

<a
  href={source.href}
  target="_blank"
  rel="noopener noreferrer nofollow"
  class:list={['text-[var(--tb-accent-fg)] underline decoration-[var(--tb-line)] underline-offset-2 hover:text-[var(--tb-ink)]', className]}
>
  {source.title}
</a>