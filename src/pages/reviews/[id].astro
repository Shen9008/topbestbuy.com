---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ImageSlot from '../../components/media/ImageSlot.astro';
import SectionHeader from '../../components/sections/SectionHeader.astro';
import SaveButton from '../../components/islands/SaveButton';
import { allProductsMap, getList, getCategory, RANKED } from '../../lib/catalog';
import { CRIT } from '../../data/scorecard';
import { SITE_DATE } from '../../data/meta';
import { formatRM, productFullName } from '../../lib/format';
import { usageScoresForProduct } from '../../lib/list-extra';
import { resolveSources } from '../../lib/sources';
import {
  articleJsonLd,
  breadcrumbListJsonLd,
  listOgImage,
  productReviewJsonLd,
  reviewDocumentTitle,
  reviewMetaDescription,
} from '../../lib/seo';
import SourceLink from '../../components/ui/SourceLink.astro';
import EditorialByline from '../../components/sections/EditorialByline.astro';
import TrustPathModule from '../../components/sections/TrustPathModule.astro';
import { categorySpotlightReviews, nearbySiblingReviews } from '../../lib/internal-links';
import AlsoRankedSection from '../../components/sections/AlsoRankedSection.astro';

export function getStaticPaths() {
  return Object.keys(allProductsMap()).map((id) => ({ params: { id } }));
}

const catalog = allProductsMap();
const { id } = Astro.params;
const product = catalog[id!];
if (!product) throw new Error(`Unknown product ${id}`);
const list = getList(product.list);
const category = getCategory(list.cat);
const peers = RANKED[product.list] ?? [];
const usageRows = usageScoresForProduct(product.subs, list.usages);
const sources = resolveSources(product.X.s);
const fullName = productFullName(product);
const crumbItems = [
  { label: 'Top 10 lists', href: '/categories' },
  { label: category?.name ?? list.cat, href: `/category/${list.cat}` },
  { label: list.short, href: `/${product.list}` },
  { label: 'Review' },
];
const reviewPath = `/reviews/${id}`;
const reviewTitle = reviewDocumentTitle(fullName);
const reviewDesc = reviewMetaDescription(fullName, product.total);
const categoryReviews = categorySpotlightReviews(list.cat, product.list, 2);
const alsoRanked = nearbySiblingReviews(product.list, product, 3, 3);
const reviewSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    articleJsonLd({
      headline: fullName,
      description: reviewDesc,
      path: reviewPath,
    }),
    productReviewJsonLd({
      name: fullName,
      description: reviewDesc,
      path: reviewPath,
    }),
    breadcrumbListJsonLd(crumbItems),
  ],
};
---

<BaseLayout
  title={reviewTitle}
  description={reviewDesc}
  canonical={reviewPath}
  ogImage={listOgImage(product.list) ?? '/og-default.png'}
  ogType="article"
  jsonLd={reviewSchema}
>
  <Breadcrumbs items={crumbItems} />

  <header class="tb-hero tb-hero--hub tb-hero--has-media tb-reveal tb-reveal--hero mt-2" aria-label="Review">
    <div class="min-w-0">
      <p class="m-0 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--tb-muted)]">
        {list.short} · #{product.rank} of 10
      </p>
      <h1 class="tb-h1 mt-3">{fullName}</h1>
      <p class="mt-3 text-lg text-[var(--tb-muted)]">
        Scores and what the evidence says, on the same scorecard as <a href={`/${product.list}`}>{list.short}</a>.
      </p>
      <div class="mt-3">
        <EditorialByline updated={false} extra={`Evidence checked ${SITE_DATE} · Scorecard v1.0`} />
      </div>
      <p class="mt-2 text-sm text-[var(--tb-muted)]">
        <span class="tb-pill tb-pill-sample">Prices as reported</span>
      </p>
    </div>
    <div class="tb-hero__media" data-tb-parallax>
      <ImageSlot
        slotId={`review-${id}`}
        aspect="match"
        label={`${fullName} hero`}
        class="h-full min-h-0 w-full"
      />
    </div>
  </header>

  <div class="tb-disclosure max-w-[var(--prose-max)]">
    <strong>We did not test this product ourselves.</strong> Scores reflect our reading of expert
    reviews, owner reviews and official specs. <a href="/how-we-rank">How we rank</a>. We may earn a
    commission from links on this page.
  </div>

  <nav class="tb-sticky-subnav" aria-label="Jump to section">
    <div class="tb-jumpbar mx-auto max-w-[var(--content-max)]">
      <a href="#review-verdict" class="shrink-0 snap-start">Verdict</a>
      <a href="#review-scorecard" class="shrink-0 snap-start">Scorecard</a>
      <a href="#review-usage" class="shrink-0 snap-start">Usage</a>
      <a href="#review-evidence" class="shrink-0 snap-start">Evidence</a>
      <a href="#review-also-ranked" class="shrink-0 snap-start">Also ranked</a>
      <a href="#review-alternatives" class="shrink-0 snap-start">Alternatives</a>
    </div>
  </nav>

  <div class="tb-editorial-layout">
    <aside class="tb-editorial-sidebar" aria-label="Review navigation">
      <div class="tb-editorial-sidebar__sticky">
        <p class="tb-h4 m-0">On this list</p>
        <a
          href={`/${product.list}`}
          class="mt-2 block text-sm font-bold text-[var(--tb-accent-fg)] no-underline hover:text-[var(--tb-ink)]"
        >
          {list.h1.split(':')[0]}
        </a>
        <nav class="mt-3 text-sm" aria-label="Ranked picks">
          <ul class="m-0 list-none space-y-1 p-0">
            {
              peers.slice(0, 5).map((p) => (
                <li>
                  <a
                    href={`/reviews/${p.id}`}
                    class:list={[
                      'block min-h-10 rounded-[var(--radius-sm)] px-2 py-2 font-semibold no-underline',
                      p.id === product.id
                        ? 'bg-[var(--tb-surface-raised)] text-[var(--tb-accent-fg)]'
                        : 'text-[var(--tb-muted)] hover:text-[var(--tb-ink)]',
                    ]}
                    aria-current={p.id === product.id ? 'page' : undefined}
                  >
                    <span class="tb-num text-xs">#{p.rank}</span> {productFullName(p)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a href="/compare" class="tb-section-link mt-4 justify-start px-0">
          Compare products
        </a>
        <a href="/tools?tool=finder" class="tb-section-link mt-2 justify-start px-0">
          Product finder
        </a>
        <a href="/saved" class="tb-section-link mt-2 justify-start px-0">
          Saved picks
        </a>
        <a href={`/category/${list.cat}`} class="tb-section-link mt-2 justify-start px-0">
          {category?.name ?? 'Category'} hub
        </a>
      </div>
    </aside>

    <div class="tb-editorial-main min-w-0 space-y-0">
      <section id="review-verdict" class="tb-band scroll-mt-28">
        <div class="tb-card tb-card--editorial">
          <p class="text-xs font-bold uppercase text-[var(--tb-muted)]">Verdict</p>
          <p class="tb-score text-4xl">
            {product.total.toFixed(1)}
            <span class="text-base font-normal text-[var(--tb-muted)]"> / 100</span>
          </p>
          <p class="text-sm">
            Ranked <strong>#{product.rank} of 10</strong> in <a href={`/${product.list}`}>{list.h1.split(':')[0]}</a>.
            {product.tag}. Best for: {product.best.toLowerCase()}.
          </p>
          {product.X.b && <p class="text-sm">{product.X.b}</p>}
          <p class="tb-score text-xl">{formatRM(product.price)}</p>
          <p class="text-sm text-[var(--tb-muted)]">{product.X.p ?? `as of ${SITE_DATE}`}</p>
          <p class="text-sm">
            <strong>After-sales and warranty:</strong> {product.X.a ?? 'Not verified'}
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <button type="button" class="tb-btn tb-btn-sm min-h-11">See price at retailer</button>
            <SaveButton client:idle productId={product.id} />
          </div>
        </div>
      </section>

      <section id="review-scorecard" class="tb-band tb-band--navy scroll-mt-28">
        <SectionHeader title="Scorecard" description="Seven criteria, same weights on every list." />
        <div class="tb-card tb-card--editorial mt-4">
          <div class="tb-tablewrap">
            <table class="tb-table">
              <thead>
                <tr>
                  <th scope="col">Criterion</th>
                  <th scope="col">Weight</th>
                  <th scope="col">Score</th>
                </tr>
              </thead>
              <tbody>
                {
                  CRIT.map((c, i) => (
                    <tr>
                      <td>{c[1]}</td>
                      <td class="tb-num">{c[2]}%</td>
                      <td class="tb-num">{product.subs[i]}/5</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="review-usage" class="tb-band scroll-mt-28">
        <SectionHeader title="Usage and trade-offs" seeAllHref="/how-we-rank" seeAllLabel="Weights" />
        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <div class="tb-card tb-card--editorial">
            <h3 class="mt-0 text-lg font-bold">Usage scores</h3>
            <div class="tb-tablewrap">
              <table class="tb-table">
                <tbody>
                  {usageRows.map((row) => (
                    <tr>
                      <th scope="row">{row.label}</th>
                      <td class="tb-num">
                        <strong>{row.score.toFixed(1)}</strong>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
            <p class="mb-0 mt-2 text-xs text-[var(--tb-muted)]">
              Same criteria, re-weighted for each use. See <a href="/how-we-rank">How we rank</a>.
            </p>
          </div>
          <div class="tb-card tb-card--editorial">
            <h3 class="mt-0 text-lg font-bold">Pros and trade-offs</h3>
            <h4 class="text-sm font-bold text-[var(--color-good)]">Pros</h4>
            <ul class="tb-pros text-sm">{product.pros.map((x) => <li>{x}</li>)}</ul>
            <h4 class="text-sm font-bold text-[var(--tb-accent-fg)]">Trade-offs</h4>
            <ul class="tb-cons text-sm">{product.cons.map((x) => <li>{x}</li>)}</ul>
          </div>
        </div>
      </section>

      <section class="tb-band tb-band--navy scroll-mt-28">
        <div class="tb-prose">
          <h2>Who should skip it</h2>
          <p>
            Be explicit. For this product:{' '}
            {product.cons[0]?.toLowerCase() ?? 'see trade-offs above'}.
          </p>
        </div>
      </section>

      <div id="review-also-ranked">
        <AlsoRankedSection
          siblings={alsoRanked}
          listShort={list.short}
          listHref={`/${product.list}`}
        />
      </div>

      <section id="review-evidence" class="tb-band scroll-mt-28">
        <SectionHeader title="Evidence sheet" description="Specs and prices with sources and dates." />
        <div class="tb-card tb-card--editorial mt-4">
          <div class="tb-tablewrap">
            <table class="tb-table">
              <thead>
                <tr>
                  <th scope="col">Field</th>
                  <th scope="col">Value</th>
                  <th scope="col">Source</th>
                  <th scope="col">Checked</th>
                </tr>
              </thead>
              <tbody>
                {
                  list.specCols.map((col, i) => (
                    <tr>
                      <th scope="row">{col.replace('*', '')}</th>
                      <td>{product.specs[i] ?? 'n/a'}</td>
                      <td>
                        {sources.length ? (
                          sources.map((s) => (
                            <SourceLink source={s} class="block text-sm" />
                          ))
                        ) : (
                          <span class="text-[var(--tb-muted)]">[Source URL]</span>
                        )}
                      </td>
                      <td class="tb-num text-sm">{SITE_DATE}</td>
                    </tr>
                  ))
                }
                <tr>
                  <th scope="row">Price</th>
                  <td class="tb-num">{formatRM(product.price)}</td>
                  <td class="text-sm text-[var(--tb-muted)]">[Retailer URL]</td>
                  <td class="tb-num text-sm">{SITE_DATE}</td>
                </tr>
                <tr>
                  <th scope="row">Warranty</th>
                  <td>{product.X.a ?? 'Not verified'}</td>
                  <td class="text-sm text-[var(--tb-muted)]">[Warranty page]</td>
                  <td class="tb-num text-sm">{SITE_DATE}</td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <section id="review-alternatives" class="tb-band tb-band--navy scroll-mt-28">
        <SectionHeader
          title="Alternatives"
          seeAllHref={`/${product.list}`}
          seeAllLabel="Full Top 10"
        />
        <div class="mt-4 grid gap-3 sm:grid-cols-3">
          {
            peers
              .filter((x) => x.id !== product.id)
              .slice(0, 3)
              .map((x) => (
                <a href={`/reviews/${x.id}`} class="tb-tile tb-card--editorial">
                  <strong>{productFullName(x)}</strong>
                  <span>{x.tag}</span>
                  <span class="tb-num">
                    {x.total.toFixed(1)}/100 · {formatRM(x.price)}
                  </span>
                </a>
              ))
          }
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          <a href="/compare" class="tb-btn tb-btn-ghost tb-btn-sm min-h-11">Compare with others</a>
          <a href="/saved" class="tb-btn tb-btn-ghost tb-btn-sm min-h-11">Saved list</a>
          <a href={`/${product.list}`} class="tb-btn tb-btn-ghost tb-btn-sm min-h-11">Back to the Top 10</a>
        </div>
      </section>

      {
        categoryReviews.length > 0 && (
          <section class="scroll-mt-28 mt-10">
            <SectionHeader
              title={`More in ${category?.name ?? list.cat}`}
              seeAllHref={`/category/${list.cat}`}
              seeAllLabel="Category lists"
            />
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              {categoryReviews.map((x) => (
                <a href={`/reviews/${x.id}`} class="tb-tile tb-card--editorial">
                  <strong>{productFullName(x)}</strong>
                  <span class="text-xs text-[var(--tb-muted)]">
                    #{x.rank} on {getList(x.list).short}
                  </span>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <TrustPathModule />
    </div>
  </div>
</BaseLayout>