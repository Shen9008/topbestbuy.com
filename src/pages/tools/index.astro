---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Icon from '../../components/ui/Icon.astro';
import ToolVisual from '../../components/illustrations/ToolVisual.astro';
import EditorialSection from '../../components/sections/EditorialSection.astro';
import SectionHeader from '../../components/sections/SectionHeader.astro';
import ToolsHub from '../../components/islands/ToolsHub';
import type { ToolVisualId } from '../../lib/feature-visuals';
import { breadcrumbListJsonLd } from '../../lib/seo';
import TrustPathModule from '../../components/sections/TrustPathModule.astro';
import { LISTS } from '../../data/lists';

const initialTool = Astro.url.searchParams.get('tool') ?? undefined;

const quickTools: [ToolVisualId, string, string][] = [
  ['finder', 'Product finder', 'Three questions, three picks.'],
  ['vacuum', 'Vacuum chooser', 'Robot, cordless or corded.'],
  ['cleanser', 'Cleanser matcher', 'Filter by skin type.'],
  ['purifier', 'Purifier room size', 'CADR for your room.'],
  ['airfryer', 'Air fryer size', 'Litres for your household.'],
  ['cost', 'Running cost', 'kWh × your tariff.'],
  ['mattress', 'Mattress firmness', 'Feel vs back support.'],
];
---

<BaseLayout
  title="Buying tools & calculators (MY)"
  description="Free Malaysia buying tools: product finder, air fryer size, purifier room size, running cost and mattress firmness pickers."
  canonical="/tools"
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [breadcrumbListJsonLd([{ label: 'Tools' }])],
  }}
>
  <Breadcrumbs items={[{ label: 'Tools' }]} />

  <header class="tb-hero tb-hero--hub tb-reveal" aria-label="Tools hub">
    <div>
      <p class="m-0 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--tb-muted)]">Calculators</p>
      <h1 class="tb-h1 mt-3 max-w-[14ch]">Buying tools</h1>
      <p class="mt-4 max-w-[42ch] text-lg text-[var(--tb-muted)]">
        Narrow the field in a minute. Estimates only — check the notes under each result.
      </p>
    </div>
  </header>

  <EditorialSection aria-labelledby="tools-quick-heading">
    <SectionHeader
      titleId="tools-quick-heading"
      title="Pick a tool"
      description="Tap a card or use the tabs below."
      seeAllHref="/compare"
      seeAllLabel="Compare products"
    />
    <div class="tb-scroll-strip tb-reveal-stagger mt-6 gap-3 lg:grid lg:grid-cols-4 lg:overflow-visible lg:pb-0">
      {
        quickTools.map(([tool, title, desc]) => (
          <a
            href={`/tools?tool=${tool}`}
            class="tb-tile tb-utility-tile min-w-[min(100%,14rem)] shrink-0 lg:min-w-0"
          >
            <div class="tb-utility-tile__icon" aria-hidden="true">
              <ToolVisual id={tool} size="md" />
            </div>
            <div>
              <h2 class="m-0 font-display text-base font-bold">{title}</h2>
              <p class="m-0 mt-1 text-sm text-[var(--tb-muted)]">{desc}</p>
            </div>
            <span class="tb-utility-tile__cta text-xs font-bold text-[var(--tb-accent)]">Open →</span>
          </a>
        ))
      }
    </div>
  </EditorialSection>

  <EditorialSection band="alt" aria-label="Interactive tools">
    <div class="mt-2">
      <ToolsHub client:load initialTool={initialTool} />
    </div>
    <p class="mt-6 text-sm">
      <a href="/compare" class="inline-flex min-h-11 items-center gap-2 font-semibold text-[var(--tb-accent)]">
        <Icon name="tool.compare" size={20} strokeWidth={2} />
        Compare products side by side
      </a>
    </p>
  </EditorialSection>

  <EditorialSection aria-labelledby="tools-lists-heading">
    <SectionHeader
      titleId="tools-lists-heading"
      title="Lists these tools support"
      seeAllHref="/categories"
      seeAllLabel="All lists"
    />
    <div class="tb-scroll-strip mt-4">
      {
        Object.keys(LISTS).map((slug) => (
          <a href={`/${slug}`} class="tb-chip shrink-0">
            {LISTS[slug as keyof typeof LISTS].short}
          </a>
        ))
      }
    </div>
    <div class="mt-8">
      <TrustPathModule />
    </div>
  </EditorialSection>
</BaseLayout>