---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import Icon from '../../components/ui/Icon.astro';
import ToolsHub from '../../components/islands/ToolsHub';

const initialTool = Astro.url.searchParams.get('tool') ?? undefined;
---

<BaseLayout
  title="Buying tools and calculators"
  description="Product finder and calculators: air fryer size, purifier room size, running cost, mattress firmness."
  canonical="/tools"
>
  <Breadcrumbs items={[{ label: 'Tools' }]} />
  <h1 class="font-display text-3xl font-extrabold">Buying tools</h1>
  <p class="max-w-[60ch] text-[var(--tb-muted)]">
    Narrow the field in a minute. Estimates only: check the notes under each result.
  </p>
  <div class="mt-6">
    <ToolsHub client:load initialTool={initialTool} />
  </div>
  <p class="mt-4 text-sm">
    <a href="/compare" class="inline-flex min-h-11 items-center gap-2 font-semibold text-[var(--tb-accent)]">
      <Icon name="compare" size={18} strokeWidth={2} />
      Compare products side by side
    </a>
  </p>
</BaseLayout>