---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import { FOUNDER } from '../data/founder';
import { TRUST_META, teamPageJsonLd } from '../lib/seo';
---

<BaseLayout
  title={TRUST_META.team.title}
  description={TRUST_META.team.description}
  canonical="/team"
  jsonLd={teamPageJsonLd()}
>
  <Breadcrumbs items={[{ label: 'Trust', href: '/about' }, { label: 'Team' }]} />

  <h1 class="tb-h1">Our team</h1>
  <p class="mt-3 max-w-[52ch] text-lg text-[var(--tb-muted)]">
    TopBestBuy is built as a small editorial operation. More specialist profiles will be added as
    lists grow.
  </p>

  <article
    id="founder"
    class="tb-card mt-8 max-w-[42rem] p-6 scroll-mt-28"
    aria-labelledby="founder-name"
  >
    <p class="m-0 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--tb-muted)]">
      Founder
    </p>
    <h2 id="founder-name" class="tb-h2 mt-2">{FOUNDER.name}</h2>
    <p class="mt-1 text-sm font-semibold text-[var(--tb-accent)]">{FOUNDER.jobTitle}</p>
    <p class="mt-1 text-sm text-[var(--tb-muted)]">{FOUNDER.location}</p>
    <p class="mt-4 text-[var(--tb-ink)]">{FOUNDER.bio}</p>
    <p class="mt-4 text-sm">
      <a
        href={FOUNDER.linkedIn}
        class="font-semibold text-[var(--tb-accent)] hover:underline"
        rel="noopener noreferrer"
        target="_blank"
      >
        LinkedIn profile
      </a>
      <span class="text-[var(--tb-muted)]"> · public professional background</span>
    </p>
  </article>

  <p class="mt-8 max-w-[52ch] text-sm text-[var(--tb-muted)]">
    For methodology and independence, see <a href="/how-we-rank">How we rank</a> and{' '}
    <a href="/editorial-policy">Editorial policy</a>.
  </p>
</BaseLayout>