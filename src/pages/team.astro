---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import TrustPathModule from '../components/sections/TrustPathModule.astro';
import { FOUNDER } from '../data/founder';
import { TRUST_META, teamPageJsonLd } from '../lib/seo';
---

<BaseLayout
  title={TRUST_META.team.title}
  description={TRUST_META.team.description}
  canonical="/team"
  jsonLd={teamPageJsonLd()}
>
  <Breadcrumbs items={[{ label: 'Trust', href: '/about' }, { label: 'Team' }]} />

  <header class="tb-reveal tb-reveal--hero">
    <h1 class="tb-h1">Our team</h1>
    <p class="mt-3 max-w-[52ch] text-lg text-[var(--tb-muted)]">
      TopBestBuy is a small editorial shop. We will add more named specialists as the lists grow.
    </p>
  </header>

  <article class="tb-reveal-stagger mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,2fr)]">
    <a
      href={FOUNDER.linkedIn}
      target="_blank"
      rel="noopener noreferrer me"
      class="tb-card tb-card--editorial no-underline"
    >
      <p class="m-0 text-xs font-bold uppercase tracking-wide text-[var(--tb-muted)]">{FOUNDER.role}</p>
      <h2 class="mt-2 mb-0 tb-h2">{FOUNDER.name}</h2>
      <p class="mt-1 text-sm text-[var(--tb-muted)]">{FOUNDER.location}</p>
      <p class="mt-3 text-sm font-semibold text-[var(--tb-accent-fg)]">LinkedIn profile →</p>
    </a>
    <div class="tb-prose">
      <p>{FOUNDER.shortBio}</p>
      <p>
        <a href="/about">About TopBestBuy</a> · <a href="/editorial-policy">Editorial policy</a> ·{' '}
        <a href="/how-we-rank">How we rank</a>
      </p>
    </div>
  </article>

  <section class="tb-band tb-band--alt tb-reveal mt-10 py-8">
    <div class="mx-auto max-w-[var(--content-max)] px-4">
      <h2 class="mt-0 tb-h3">Policies and contact</h2>
      <p class="max-w-[65ch] text-sm text-[var(--tb-muted)]">
        Lists are researched from expert reviews, owner feedback and official specs — we do not
        accept payment for rank. Every correction is logged.
      </p>
      <TrustPathModule />
    </div>
  </section>
</BaseLayout>