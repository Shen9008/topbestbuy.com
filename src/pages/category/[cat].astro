---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import { CATEGORY_IDS } from '../../lib/routes';
import { getCategory, RANKED } from '../../lib/catalog';
import { LISTS } from '../../data/lists';
import { POSTS } from '../../data/posts';
import { productFullName } from '../../lib/format';
import { SITE_DATE } from '../../data/meta';

export function getStaticPaths() {
  return CATEGORY_IDS.map((cat) => ({ params: { cat } }));
}

const { cat } = Astro.params;
const category = getCategory(cat!);
if (!category) throw new Error(`Unknown category ${cat}`);
---

<BaseLayout
  title={`${category.name}: Top 10 lists`}
  description={`Top 10 lists in ${category.name.toLowerCase()} for Malaysia.`}
  canonical={`/category/${cat}`}
>
  <Breadcrumbs items={[{ label: 'Top 10 lists', href: '/categories' }, { label: category.name }]} />
  <h1 class="font-display text-3xl font-extrabold">{category.name}</h1>
  <p class="text-[var(--tb-muted)]">{category.desc}</p>

  <h2 class="mt-8 font-display text-2xl font-bold">Live lists</h2>
  {
    category.lists.length ? (
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {category.lists.map((slug) => {
          const L = LISTS[slug as keyof typeof LISTS];
          const p = RANKED[slug]?.[0];
          return (
            <a href={`/${slug}`} class="tb-tile">
              <h3 class="m-0 font-display text-lg font-bold">{L.h1}</h3>
              {p && (
                <span class="text-sm">
                  #1: {productFullName(p)} ({p.total.toFixed(1)}/100)
                </span>
              )}
              <span class="text-xs text-[var(--tb-muted)]">Updated {SITE_DATE}</span>
            </a>
          );
        })}
      </div>
    ) : (
      <div class="tb-callout">No live lists yet. Vote below to bring one forward.</div>
    )
  }

  <h2 class="mt-8 font-display text-2xl font-bold">Coming next</h2>
  <div class="mt-3 flex flex-wrap gap-2">
    {category.soon.map((s) => (
      <a href="/coming-next" class="tb-chip">
        {s}
      </a>
    ))}
  </div>

  <h2 class="mt-8 font-display text-2xl font-bold">Related guides</h2>
  <div class="mt-3 grid gap-3 sm:grid-cols-3">
    {Object.entries(POSTS)
      .slice(0, 3)
      .map(([id, p]) => (
        <a href={`/guides/${id.replace(/^blog-/, '')}`} class="tb-tile">
          <span class="tb-pill">{p.type}</span>
          <h3 class="m-0 text-base font-bold">{p.h1}</h3>
        </a>
      ))}
  </div>
</BaseLayout>