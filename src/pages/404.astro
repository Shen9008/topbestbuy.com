---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." noindex>
  <h1 class="tb-h1">That page is not here</h1>
  <p class="text-[var(--tb-muted)]">Try a Top 10 list, guides, or search from the header.</p>
  <div class="mt-6 flex flex-wrap gap-2">
    <a href="/categories" class="tb-btn">Browse lists</a>
    <a href="/" class="tb-btn tb-btn-ghost">Home</a>
  </div>
</BaseLayout>