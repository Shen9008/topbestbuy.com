---
import BaseLayout from '../layouts/BaseLayout.astro';
import StubShell from '../components/pages/StubShell.astro';
---

<BaseLayout title="Page not found" noindex={true} description="The page you requested is not on TopBestBuy yet.">
  <StubShell
    title="We could not find that page"
    kicker="404"
    description="Check the URL or return home. Full search ships in Phase 4."
    showHeroImage={false}
  >
    <p>
      <a
        href="/"
        class="cursor-pointer font-semibold text-[var(--tb-accent)] underline underline-offset-4"
        >Return home</a
      >
    </p>
  </StubShell>
</BaseLayout>