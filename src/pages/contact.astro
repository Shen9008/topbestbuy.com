---
import BaseLayout from '../layouts/BaseLayout.astro';
import StubShell from '../components/pages/StubShell.astro';
import { TRUST_META } from '../lib/seo';
---

<BaseLayout
  title={TRUST_META.contact.title}
  description={TRUST_META.contact.description}
  canonical="/contact"
  noindex
>
  <StubShell
    title="Contact"
    kicker="Trust"
    description="Questions about a list, a correction, or how we score? We are wiring a contact channel. Until it is live, use the corrections page so we can log fixes."
  />
</BaseLayout>