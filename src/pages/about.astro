---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import TrustPathModule from '../components/sections/TrustPathModule.astro';
import { FOUNDER } from '../data/founder';
import { TRUST_META, aboutPageJsonLd } from '../lib/seo';
---

<BaseLayout
  title={TRUST_META.about.title}
  description={TRUST_META.about.description}
  canonical="/about"
  ogImage="/images/inventory-refresh/about-hero.webp"
  jsonLd={aboutPageJsonLd()}
>
  <Breadcrumbs items={[{ label: 'Trust centre', href: '/trust' }, { label: 'About us' }]} />
  <header class="tb-reveal tb-reveal--hero">
    <h1 class="tb-h1">About us</h1>
    <p class="mt-3 max-w-[52ch] text-lg text-[var(--tb-muted)]">
      Independent Top 10 lists for Malaysia — scored, sourced, and updated on a schedule.
    </p>
  </header>
  <article class="tb-prose mt-6 tb-reveal" data-tb-motion>
    <p>
      TopBestBuy helps people in Malaysia pick a good product without reading fifty tabs. Each
      list is ten picks, ranked on a published scorecard, with trade-offs stated plainly.
    </p>
    <h2>Founder</h2>
    <p>
      {FOUNDER.shortBio}{' '}
      <a href="/team">Meet the team</a> ·{' '}
      <a href={FOUNDER.linkedIn} rel="noopener noreferrer me">LinkedIn</a>
    </p>
    <h2>Who we write for</h2>
    <p>
      Households choosing appliances, bedroom and lifestyle products, who want a clear shortlist
      and honest reasons.
    </p>
    <h2>What we promise</h2>
    <ul>
      <li>Rankings are never for sale.</li>
      <li>We say what we did and did not do.</li>
      <li>Every price and spec has a date and a source.</li>
      <li>Mistakes are fixed and logged.</li>
    </ul>
    <h2>Who runs TopBestBuy</h2>
    <p>
      <strong>{FOUNDER.name}</strong> ({FOUNDER.jobTitle}) leads TopBestBuy from {FOUNDER.location}.
      He publishes scored Top 10 lists for Malaysia shoppers with cited sources and a public
      scorecard. See <a href="/team">team</a> for his background.
    </p>
    <p>
      <a href="/team">Meet the team</a> ·{' '}
      <a href={FOUNDER.linkedIn} rel="noopener noreferrer" target="_blank">
        {FOUNDER.name} on LinkedIn
      </a>
    </p>
  </article>
  <div class="mt-8 max-w-[var(--prose-max)]">
    <TrustPathModule />
  </div>
</BaseLayout>