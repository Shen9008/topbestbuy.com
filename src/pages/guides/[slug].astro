---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import SectionHeader from '../../components/sections/SectionHeader.astro';
import GuideCard from '../../components/sections/GuideCard.astro';
import GuidePhoto from '../../components/media/GuidePhoto.astro';
import { POSTS } from '../../data/posts';
import { LISTS } from '../../data/lists';
import { FEATURED_GUIDES, guideBanner, type GuideId } from '../../lib/guide-banners';
import {
  articleJsonLd,
  breadcrumbListJsonLd,
  normalizeGuideBodyHtml,
} from '../../lib/seo';
import EditorialByline from '../../components/sections/EditorialByline.astro';
import TrustPathModule from '../../components/sections/TrustPathModule.astro';

export function getStaticPaths() {
  return (Object.keys(POSTS) as GuideId[]).map((key) => ({
    params: { slug: key.replace(/^blog-/, '') },
    props: { postId: key },
  }));
}

const { postId } = Astro.props;
const post = POSTS[postId];
const banner = guideBanner(postId);
const related: readonly string[] = post.related;
const relatedGuides = [...new Set([
  ...related.filter((id): id is GuideId => Object.hasOwn(POSTS, id)),
  ...FEATURED_GUIDES,
  ...(Object.keys(POSTS) as GuideId[]),
])].filter((id) => id !== postId).slice(0, 3);
const relatedResources = related.filter((id) => !Object.hasOwn(POSTS, id));
const otherGuides = Object.entries(POSTS)
  .filter(([id]) => id !== postId)
  .slice(0, 4);
const guidePath = `/guides/${Astro.params.slug}`;
const crumbItems = [{ label: 'Guides', href: '/guides' }, { label: post.type }];
const guideSchema = {
  '@context': 'https://schema.org',
  '@graph': [
    articleJsonLd({
      headline: post.h1,
      description: post.meta,
      path: guidePath,
      type: 'BlogPosting',
    }),
    breadcrumbListJsonLd(crumbItems),
  ],
};
const bodyHtml = normalizeGuideBodyHtml(post.body);
---

<BaseLayout
  title={post.title}
  description={post.meta}
  canonical={guidePath}
  ogType="article"
  ogImage={banner.large}
  jsonLd={guideSchema}
>
  <Breadcrumbs items={crumbItems} />

  <header class="tb-editorial-center mt-2">
    <span class="tb-pill">{post.type}</span>
    <h1 class="mt-2 tb-h1">{post.h1}</h1>
    <div class="mt-2">
      <EditorialByline extra={`${post.time} read`} />
    </div>
    <p class="mt-1 text-sm">
      <span class="tb-pill tb-pill-sample">Sample article</span>
    </p>
  </header>

  <div class="my-6">
    <GuidePhoto id={postId} hero />
  </div>

  <div class="tb-disclosure tb-editorial-center">
    <strong>How we make money:</strong> we may earn a commission from links on this page. This
    never affects our rankings. <a href="/how-we-rank">How we rank</a>
  </div>

  <nav class="tb-sticky-subnav" aria-label="Jump to section">
    <div class="tb-jumpbar mx-auto max-w-[var(--content-max)]">
      <a href="#guide-tldr" class="shrink-0 snap-start">Short answer</a>
      <a href="#guide-body" class="shrink-0 snap-start">Article</a>
      <a href="#guide-more" class="shrink-0 snap-start">Keep reading</a>
    </div>
  </nav>

  <div class="tb-editorial-layout">
    <aside class="tb-editorial-sidebar" aria-label="Guide index">
      <div class="tb-editorial-sidebar__sticky">
        <p class="tb-h4 m-0">More guides</p>
        <nav class="mt-3 text-sm" aria-label="Other guides">
          <ul class="m-0 list-none space-y-1 p-0">
            {
              otherGuides.map(([id, p]) => (
                <li>
                  <a
                    href={`/guides/${id.replace(/^blog-/, '')}`}
                    class="block min-h-10 rounded-[var(--radius-sm)] px-2 py-2 font-semibold text-[var(--tb-muted)] no-underline hover:text-[var(--tb-ink)]"
                  >
                    {p.h1}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a href="/guides" class="tb-section-link mt-4 justify-start px-0">
          All guides
        </a>
        <a href="/tools?tool=finder" class="tb-section-link mt-2 justify-start px-0">
          Product finder
        </a>
      </div>
    </aside>

    <div class="tb-editorial-main min-w-0">
      <section id="guide-tldr" class="scroll-mt-28">
        <div class="tb-callout tb-card--editorial tb-editorial-center border-2 border-[var(--tb-ink)]">
          <strong>Short answer</strong>
          <p class="m-0 mt-2">{post.tldr}</p>
        </div>
      </section>

      <section id="guide-body" class="scroll-mt-28">
        <article class="tb-prose mx-auto mt-6 max-w-[65ch]" set:html={bodyHtml} />
      </section>

    </div>
  </div>

  <section id="guide-more" class="scroll-mt-[var(--subnav-height)] mt-12" aria-labelledby="guide-more-title">
    <SectionHeader titleId="guide-more-title" title="Keep reading" align="left" seeAllHref="/guides" seeAllLabel="See all guides" />
    <div class="tb-guide-grid tb-reveal-stagger">
      {relatedGuides.map((id) => <GuideCard id={id} />)}
    </div>
    <div class="mt-6 flex flex-wrap gap-2">
      {relatedResources.map((id) => {
        const list = LISTS[id as keyof typeof LISTS];
        return list ? (
          <a href={`/${id}`} class="tb-chip">{list.short}: Top 10</a>
        ) : (
          <a href="/how-we-rank" class="tb-chip">How we rank</a>
        );
      })}
    </div>
  </section>

  <TrustPathModule />
</BaseLayout>
