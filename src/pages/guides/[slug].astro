---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import SectionHeader from '../../components/sections/SectionHeader.astro';
import { POSTS } from '../../data/posts';
import { LISTS } from '../../data/lists';
import { SITE_DATE } from '../../data/meta';
import EditorialByline from '../../components/sections/EditorialByline.astro';
import TrustPathModule from '../../components/sections/TrustPathModule.astro';
import { articlePageGraph } from '../../lib/json-ld';

export function getStaticPaths() {
  return Object.keys(POSTS).map((key) => ({
    params: { slug: key.replace(/^blog-/, '') },
    props: { postId: key },
  }));
}

const { postId } = Astro.props;
const post = POSTS[postId as keyof typeof POSTS];
const otherGuides = Object.entries(POSTS)
  .filter(([id]) => id !== postId)
  .slice(0, 4);
const guidePath = `/guides/${Astro.params.slug}`;
const articleLd = JSON.stringify(articlePageGraph(post.h1, post.meta, guidePath));
---

<BaseLayout title={post.title} description={post.meta} canonical={guidePath}>
  <script type="application/ld+json" set:html={articleLd} />

  <Breadcrumbs items={[{ label: 'Guides', href: '/guides' }, { label: post.type }]} />

  <header class="mt-2 max-w-[var(--prose-max)]">
    <span class="tb-pill">{post.type}</span>
    <h1 class="mt-2 tb-h1">{post.h1}</h1>
    <div class="mt-2">
      <EditorialByline extra={`${post.time} read`} />
    </div>
    <p class="mt-1 text-sm">
      <span class="tb-pill tb-pill-sample">Sample article</span>
    </p>
  </header>

  <div class="tb-disclosure max-w-[var(--prose-max)]">
    <strong>How we make money:</strong> we may earn a commission from links on this page. This
    never affects our rankings. <a href="/how-we-rank">How we rank</a>
  </div>

  <nav class="tb-sticky-subnav" aria-label="Jump to section">
    <div class="tb-jumpbar mx-auto max-w-[var(--content-max)]">
      <a href="#guide-tldr" class="shrink-0 snap-start">Short answer</a>
      <a href="#guide-body" class="shrink-0 snap-start">Article</a>
      <a href="#guide-more" class="shrink-0 snap-start">Keep reading</a>
    </div>
  </nav>

  <div class="tb-editorial-layout">
    <aside class="tb-editorial-sidebar" aria-label="Guide index">
      <div class="tb-editorial-sidebar__sticky">
        <p class="tb-h4 m-0">More guides</p>
        <nav class="mt-3 text-sm" aria-label="Other guides">
          <ul class="m-0 list-none space-y-1 p-0">
            {
              otherGuides.map(([id, p]) => (
                <li>
                  <a
                    href={`/guides/${id.replace(/^blog-/, '')}`}
                    class="block min-h-10 rounded-[var(--radius-sm)] px-2 py-2 font-semibold text-[var(--tb-muted)] no-underline hover:text-[var(--tb-ink)]"
                  >
                    {p.h1}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a href="/guides" class="tb-section-link mt-4 justify-start px-0">
          All guides
        </a>
        <a href="/tools?tool=finder" class="tb-section-link mt-2 justify-start px-0">
          Product finder
        </a>
      </div>
    </aside>

    <div class="tb-editorial-main min-w-0">
      <section id="guide-tldr" class="scroll-mt-28">
        <div class="tb-callout tb-card--editorial border-2 border-[var(--tb-ink)]">
          <strong>Short answer</strong>
          <p class="m-0 mt-2">{post.tldr}</p>
        </div>
      </section>

      <section id="guide-body" class="scroll-mt-28">
        <article class="tb-prose mt-6" set:html={post.body} />
      </section>

      <section id="guide-more" class="scroll-mt-28 mt-10">
        <SectionHeader title="Keep reading" seeAllHref="/guides" seeAllLabel="See all guides" />
        <div class="tb-scroll-strip mt-4 gap-2">
          {
            post.related.map((r) =>
              LISTS[r as keyof typeof LISTS] ? (
                <a href={`/${r}`} class="tb-chip shrink-0">
                  {LISTS[r as keyof typeof LISTS].short}: Top 10
                </a>
              ) : POSTS[r as keyof typeof POSTS] ? (
                <a href={`/guides/${r.replace(/^blog-/, '')}`} class="tb-chip shrink-0">
                  {POSTS[r as keyof typeof POSTS].h1}
                </a>
              ) : (
                <a href="/how-we-rank" class="tb-chip shrink-0">
                  How we rank
                </a>
              ),
            )
          }
        </div>
      </section>

      <TrustPathModule />
    </div>
  </div>
</BaseLayout>