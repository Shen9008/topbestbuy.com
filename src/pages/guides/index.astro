---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import EditorialSection from '../../components/sections/EditorialSection.astro';
import SectionHeader from '../../components/sections/SectionHeader.astro';
import GuideCard from '../../components/sections/GuideCard.astro';
import { POSTS } from '../../data/posts';
import { FEATURED_GUIDES, type GuideId } from '../../lib/guide-banners';
import { breadcrumbListJsonLd } from '../../lib/seo';

const remaining = (Object.keys(POSTS) as GuideId[]).filter(
  (id) => !FEATURED_GUIDES.some((featured) => featured === id),
);
---

<BaseLayout
  title="Buying guides for Malaysia"
  description="Plain-English guides from TopBestBuy: worth-it answers, how-tos and myth-busters tied to our scored Top 10 lists in Malaysia."
  canonical="/guides"
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [breadcrumbListJsonLd([{ label: 'Guides' }])],
  }}
>
  <Breadcrumbs items={[{ label: 'Guides' }]} />

  <header class="tb-hero tb-hero--hub tb-reveal" aria-label="Guides hub">
    <div>
      <h1 class="tb-h1">Guides and explainers</h1>
      <p class="mt-4 max-w-[46ch] text-lg text-[var(--tb-muted)]">
        Practical answers to the questions that come up before and after you buy.
      </p>
    </div>
  </header>

  <EditorialSection band="default" aria-labelledby="guides-featured-heading">
    <SectionHeader
      titleId="guides-featured-heading"
      title="Featured reads"
      align="left"
      seeAllHref="#more-guides"
      seeAllLabel="More guides"
    />
    <div class="tb-guide-grid tb-reveal-stagger">
      {FEATURED_GUIDES.map((id) => <GuideCard id={id} />)}
    </div>
  </EditorialSection>

  <EditorialSection id="more-guides" band="alt" aria-labelledby="more-guides-heading">
    <SectionHeader titleId="more-guides-heading" title="More guides" align="left" />
    <div class="tb-guide-grid tb-reveal-stagger">
      {remaining.map((id) => <GuideCard id={id} />)}
    </div>
  </EditorialSection>
</BaseLayout>
