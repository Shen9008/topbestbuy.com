---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Icon from '../components/ui/Icon.astro';
import { CRIT } from '../data/scorecard';
import { SITE_DATE } from '../data/meta';
import { SCORE_CRIT_ICONS, type IconMapKey } from '../icons';
---

<BaseLayout
  title="How we score"
  description="Our seven-criterion scorecard, weights, tie-breakers and changelog."
  canonical="/how-we-rank"
>
  <Breadcrumbs items={[{ label: 'How we score' }]} />
  <h1 class="tb-h1">How we score</h1>
  <p class="max-w-[60ch] text-[var(--tb-muted)]">
    Every Top 10 uses the same scorecard, so you can compare lists and check our working.
  </p>
  <div class="tb-callout">
    <strong>What we do and do not do.</strong> We research and aggregate expert reviews, owner reviews,
    official specs and dated retailer prices. We do not test products ourselves.
  </div>
  <h2 class="mt-8 tb-h2">The seven criteria</h2>
  <div class="tb-tablewrap mt-3">
    <table class="tb-table">
      <thead>
        <tr>
          <th>Criterion</th>
          <th>Weight</th>
          <th>What we look at</th>
        </tr>
      </thead>
      <tbody>
        {
          CRIT.map((c) => {
            const icon = SCORE_CRIT_ICONS[c[0]] as IconMapKey | undefined;
            return (
              <tr>
                <td>
                  <span class="inline-flex items-center gap-2">
                    {icon ? (
                      <span class="tb-icon-slot tb-icon-slot-pad-16" aria-hidden="true">
                        <Icon name={icon} size={20} />
                      </span>
                    ) : null}
                    {c[1]}
                  </span>
                </td>
                <td class="tb-num">{c[2]}%</td>
                <td>{c[3]}</td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>
  <div class="tb-prose mt-8">
    <h2>The maths</h2>
    <p>
      Each criterion gets a sub-score from 0 to 5. The total is the sum of weight × score ÷ 5,
      giving a score out of 100. Ties break on reliability, then value.
    </p>
    <p>
      Total = Σ (weight × sub-score ÷ 5). Example: 5/5 on performance adds 30 points; 4/5 adds
      24.
    </p>
    <h2>Refresh schedule</h2>
    <p>Prices monthly. Full re-score quarterly. Recalls or major price changes trigger updates.</p>
    <h2>Changelog</h2>
    <p>
      <strong>{SITE_DATE}</strong> · Scorecard v1.0 · First public scorecard (mockup parity).
    </p>
  </div>
</BaseLayout>