---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Icon from '../components/ui/Icon.astro';
import EditorialSection from '../components/sections/EditorialSection.astro';
import SectionHeader from '../components/sections/SectionHeader.astro';
import { CRIT } from '../data/scorecard';
import { SITE_DATE } from '../data/meta';
import { SCORE_CRIT_ICONS, type IconMapKey } from '../icons';
import { breadcrumbListJsonLd } from '../lib/seo';

const trustLinks = [
  { href: '/how-we-rank', label: 'How we rank' },
  { href: '/editorial-policy', label: 'Editorial policy' },
  { href: '/affiliate-disclosure', label: 'How we make money' },
  { href: '/corrections', label: 'Corrections' },
  { href: '/about', label: 'About us' },
];
---

<BaseLayout
  title="How we rank products in Malaysia"
  description="Seven weighted criteria, usage scores, tie-breakers and exclusions. How TopBestBuy builds every Top 10 list for Malaysia."
  canonical="/how-we-rank"
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [breadcrumbListJsonLd([{ label: 'How we rank' }])],
  }}
>
  <Breadcrumbs items={[{ label: 'How we score' }]} />

  <header class="tb-hero tb-hero--editorial tb-hero--hub tb-reveal" aria-label="Methodology">
    <div>
      <p class="m-0 text-xs font-semibold uppercase tracking-[0.14em] text-[var(--tb-muted)]">Trust</p>
      <h1 class="tb-h1 mt-3 max-w-[16ch]">How we score</h1>
      <p class="mt-4 max-w-[42ch] text-lg text-[var(--tb-muted)]">
        Every Top 10 uses the same scorecard, so you can compare lists and check our working.
      </p>
    </div>
  </header>

  <div class="tb-editorial-layout mt-4">
    <aside class="tb-editorial-sidebar" aria-label="Trust pages">
      <div class="tb-editorial-sidebar__sticky">
        <p class="tb-h4 m-0">Trust centre</p>
        <nav class="mt-3 text-sm" aria-label="Related trust pages">
          <ul class="m-0 list-none space-y-1 p-0">
            {
              trustLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class:list={[
                      'block min-h-10 rounded-[var(--radius-sm)] px-2 py-2 font-semibold no-underline',
                      link.href === '/how-we-rank'
                        ? 'bg-[var(--tb-surface-raised)] text-[var(--tb-accent-fg)]'
                        : 'text-[var(--tb-muted)] hover:text-[var(--tb-ink)]',
                    ]}
                    aria-current={link.href === '/how-we-rank' ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </aside>

    <div class="tb-editorial-main min-w-0 space-y-2">
      <div class="tb-callout tb-card--editorial tb-editorial-center">
        <strong>What we do and do not do.</strong> We research and aggregate expert reviews, owner reviews,
        official specs and dated retailer prices. We do not test products ourselves.
      </div>

      <EditorialSection band="default" aria-labelledby="crit-heading" class="!py-8">
        <SectionHeader titleId="crit-heading" title="The seven criteria" />
        <div class="tb-card tb-card--editorial mt-4">
          <div class="tb-tablewrap">
            <table class="tb-table">
              <thead>
                <tr>
                  <th scope="col">Criterion</th>
                  <th scope="col">Weight</th>
                  <th scope="col">What we look at</th>
                </tr>
              </thead>
              <tbody>
                {
                  CRIT.map((c) => {
                    const icon = SCORE_CRIT_ICONS[c[0]] as IconMapKey | undefined;
                    return (
                      <tr>
                        <td>
                          <span class="inline-flex items-center gap-2">
                            {icon ? (
                              <span class="tb-icon-slot tb-icon-slot-pad-16" aria-hidden="true">
                                <Icon name={icon} size={20} />
                              </span>
                            ) : null}
                            {c[1]}
                          </span>
                        </td>
                        <td class="tb-num">{c[2]}%</td>
                        <td>{c[3]}</td>
                      </tr>
                    );
                  })
                }
              </tbody>
            </table>
          </div>
        </div>
      </EditorialSection>

      <EditorialSection band="alt" class="!py-8">
        <article class="tb-prose tb-prose--center">
          <h2>The maths</h2>
          <p>
            Each criterion gets a sub-score from 0 to 5. The total is the sum of weight × score ÷ 5,
            giving a score out of 100. Ties break on reliability, then value.
          </p>
          <div class="tb-callout">
            <span class="tb-num">Total = Σ (weight × sub-score ÷ 5)</span>. Example: 5/5 on performance
            adds 30 points; 4/5 adds 24.
          </div>
          <h2>Usage scores</h2>
          <p>
            One ranking cannot suit everyone, so each list also shows three usage scores. They use the
            same sub-scores with different weights. For example, "tight budget" counts value at 40%.
          </p>
          <h2>What gets a product excluded</h2>
          <ul>
            <li>Not sold in Malaysia or discontinued.</li>
            <li>Under a safety recall.</li>
            <li>Too little independent evidence to score fairly.</li>
            <li>Sponsor payment is never a reason to include or exclude.</li>
          </ul>
          <h2>Evidence we accept</h2>
          <p>
            Independent expert reviews and lab tests we can link to, verified-purchase owner reviews on
            named retailers, manufacturer specifications, regulator notices. Each fact on a page carries
            a source and date.
          </p>
          <h2>Refresh schedule</h2>
          <p>
            Prices monthly. Full re-score quarterly. Recalls or major price changes trigger updates within
            five working days.
          </p>
          <h2>Changelog</h2>
          <div class="tb-tablewrap">
            <table class="tb-table">
              <thead>
                <tr>
                  <th scope="col">Date</th>
                  <th scope="col">Version</th>
                  <th scope="col">Change</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td>{SITE_DATE}</td>
                  <td>1.0</td>
                  <td>First public scorecard (mockup parity).</td>
                </tr>
              </tbody>
            </table>
          </div>
          <p class="text-sm text-[var(--tb-muted)]">
            Related: <a href="/editorial-policy">Editorial policy</a> ·
            <a href="/affiliate-disclosure">How we make money</a> · <a href="/corrections">Corrections</a>
          </p>
        </article>
      </EditorialSection>
    </div>
  </div>
</BaseLayout>