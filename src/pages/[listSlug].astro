---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import ImageSlot from '../components/media/ImageSlot.astro';
import ProductCard from '../components/list/ProductCard.astro';
import ListPageClient from '../components/islands/ListPageClient';
import PriceAlertForm from '../components/islands/PriceAlertForm';
import { LIST_SLUGS } from '../lib/routes';
import { RANKED, getList, getCategory, budgetBands } from '../lib/catalog';
import { SITE_DATE } from '../data/meta';
import { productFullName } from '../lib/format';
import {
  TOOL_FOR,
  faqJsonLd,
  itemListJsonLd,
  priceBandCopy,
  quickPicksTable,
  sourcesSection,
  usageBlocks,
} from '../lib/list-extra';
import { POSTS } from '../data/posts';
import type { ListSlug } from '../lib/catalog';
import Icon from '../components/ui/Icon.astro';
import ListMethodologyStrip from '../components/sections/ListMethodologyStrip.astro';
import { LIST_SLUG_ICONS } from '../icons';

export function getStaticPaths() {
  return LIST_SLUGS.map((listSlug) => ({ params: { listSlug } }));
}

const { listSlug } = Astro.params;
const list = getList(listSlug!);
const rows = RANKED[listSlug!] ?? [];
const category = getCategory(list.cat);
const { lo, hi } = budgetBands(rows);
const top3 = rows.slice(0, 3);
const slug = listSlug as ListSlug;
const sources = sourcesSection(slug, rows);

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    itemListJsonLd(
      list.h1,
      rows,
      Astro.site?.href?.replace(/\/$/, '') ?? 'https://topbestbuy.online',
    ),
    faqJsonLd(list.faq),
  ],
};

const tool = TOOL_FOR[list.kind] ?? ['finder', 'product finder'];
const relatedPosts = Object.entries(POSTS)
  .filter(([, p]) => (p.related as readonly string[]).includes(listSlug!))
  .slice(0, 3);
---

<BaseLayout title={list.title} description={list.meta} canonical={`/${listSlug}`}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <Breadcrumbs
    items={[
      { label: 'Top 10 lists', href: '/categories' },
      { label: category?.name ?? list.cat, href: `/category/${list.cat}` },
      { label: list.short },
    ]}
  />

  <ImageSlot slotId={`list-hero-${listSlug}`} aspect="banner" label={`List hero: ${list.short}`} />

  <h1 class="tb-h1 flex flex-wrap items-center gap-3">
    {
      LIST_SLUG_ICONS[listSlug!] ? (
        <span class="tb-icon-slot tb-icon-slot-pad-16 shrink-0" aria-hidden="true">
          <Icon name={LIST_SLUG_ICONS[listSlug!]} size={32} />
        </span>
      ) : null
    }
    <span>{list.h1}</span>
  </h1>

  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm text-[var(--tb-muted)]">
    <span>By <strong class="text-[var(--tb-ink)]">[Editor name]</strong></span>
    <span>Updated {SITE_DATE}</span>
    <span>Prices checked {SITE_DATE}</span>
    <span>Scorecard v1.0</span>
    <span class="tb-pill tb-pill-sample">Prices as reported, verify</span>
  </p>

  <div class="tb-disclosure">
    <strong>How we make money:</strong> we may earn a commission if you buy through links on
    this page, at no extra cost to you. This never affects our rankings.
    <a href="/how-we-rank">How we rank</a>
  </div>

  {
    'reviewer' in list && list.reviewer && (
      <div class="tb-callout">
        <strong>Evidence bar for skincare.</strong> Reviewed by [Dermatologist or pharmacist
        name, credentials]. We do not test products and this is not medical advice.
      </div>
    )
  }

  <p class="mt-4 max-w-[68ch] text-lg">
    <strong>Short answer:</strong> the top-scoring pick is {productFullName(top3[0]!)} (
    {top3[0]!.total.toFixed(1)}/100).
    {top3[1] && ` ${productFullName(top3[1])} is a close second`}
    {top3[2] && `, and ${productFullName(top3[2])} is third`}. This guide is for {list.audience}.
  </p>

  <aside class="tb-eeat" aria-label="Authors and fact-check">
    <p class="text-sm">
      <strong>Written by [Editor name]</strong> · Fact-checked {SITE_DATE} ·
      <a href="/how-we-rank">Scorecard v1.0</a> · <a href="/affiliate-disclosure">Independence</a>
    </p>
  </aside>

  <div class="tb-prose mt-4" set:html={list.intro} />

  <ListMethodologyStrip />

  <div class="tb-callout tb-spotlight border-2 border-[var(--tb-ink)]">
    <strong>Key takeaways</strong>
    <ul class="mb-0 mt-2 list-disc pl-5 text-sm">
      <li>Scored on 7 criteria; weights on <a href="/how-we-rank">How we rank</a>.</li>
      <li>Prices are third-party reported and dated. Verify at checkout.</li>
      <li>
        Use the <a href={`/tools?tool=${tool[0]}`}>{tool[1]}</a> before you choose.
      </li>
    </ul>
  </div>

  <div class="my-4 grid gap-2" aria-label="Top 3">
    {
      top3.map((p) => (
        <a
          href={`#${p.id}`}
          class="grid grid-cols-[auto_1fr_auto] items-center gap-3 rounded-[var(--radius-md)] border border-[var(--tb-line)] bg-[var(--tb-surface)] p-3 no-underline"
        >
          <span class="tb-rank">{p.rank}</span>
          <span>
            <b class="text-[var(--tb-ink)]">{productFullName(p)}</b>
            <br />
            <small class="text-[var(--tb-muted)]">
              {p.tag}: {p.best}
            </small>
          </span>
          <span class="tb-score text-xl">{p.total.toFixed(1)}</span>
        </a>
      ))
    }
  </div>

  <nav class="tb-jumpbar" aria-label="Jump to section">
    {
      [
        ['sec-compare', 'Compare'],
        ['sec-picks', 'All 10'],
        ['sec-best', 'Best for'],
        ['sec-price', 'Price'],
        ['sec-guide', 'Guide'],
        ['sec-faq', 'FAQ'],
        ['sec-sources', 'Sources'],
      ].map(([id, label]) => (
        <a href={`#${id}`} data-jump-sec={id}>
          {label}
        </a>
      ))
    }
  </nav>

  <div class="grid items-start gap-8 lg:grid-cols-[15rem_1fr]">
    <nav class="sticky top-28 hidden text-sm lg:block" aria-label="On this page">
      <ol class="m-0 list-none border-l-2 border-[var(--tb-line)] p-0">
        {
          ['compare', 'picks', 'best', 'price', 'how', 'guide', 'faq', 'sources'].map((sec) => (
            <li>
              <a
                href={`#sec-${sec}`}
                class="block py-1.5 pl-3 text-[var(--tb-muted)] hover:text-[var(--tb-ink)]"
              >
                {sec.charAt(0).toUpperCase() + sec.slice(1)}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <div>
      <section id="sec-compare" class="scroll-mt-28">
        <h2 class="tb-h2">Compare at a glance</h2>
        <ListPageClient
          client:load
          listSlug={listSlug!}
          rows={rows}
          specCols={list.specCols}
          usages={list.usages}
          budgetLo={lo}
          budgetHi={hi}
        />
        <div class="tb-tablewrap mt-3">
          <table class="tb-table" id="cmp-table">
            <thead>
              <tr>
                <th scope="col">#</th>
                <th scope="col">Product</th>
                <th scope="col">Score</th>
                <th scope="col">Price (RM)</th>
                {list.specCols.map((c) => (
                  <th scope="col">{c}</th>
                ))}
                <th scope="col">Best for</th>
              </tr>
            </thead>
            <tbody id="cmp-table-body">
              {
                rows.map((p) => (
                  <tr>
                    <td>
                      <span class="tb-rank">{p.rank}</span>
                    </td>
                    <td>
                      <a href={`#${p.id}`} class="font-semibold text-[var(--tb-accent)]">
                        {productFullName(p)}
                      </a>
                      <br />
                      <small>{p.tag}</small>
                    </td>
                    <td class="tb-num">
                      <strong>{p.total.toFixed(1)}</strong>
                    </td>
                    <td class="tb-num">{p.price.toLocaleString('en-MY')}</td>
                    {p.specs.map((s) => (
                      <td>{s}</td>
                    ))}
                    <td>{p.best}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-2 text-xs text-[var(--tb-muted)]">
          Prices as reported and dated {SITE_DATE}; verify at checkout.
        </p>
      </section>

      <section id="sec-picks" class="mt-10 scroll-mt-28">
        <h2 class="tb-h2">All 10 picks</h2>
        <div id="prods">
          {rows.map((p) => (
            <ProductCard product={p} list={list} />
          ))}
        </div>
      </section>

      <section id="sec-best" class="tb-prose mt-10 scroll-mt-28">
        <h2>Best {list.short.toLowerCase()} in Malaysia by need and budget</h2>
        <p>
          Different households weigh price, performance and support differently, so we
          re-score all ten picks for each profile below.
        </p>
        <div class="tb-tablewrap not-prose" set:html={quickPicksTable(rows, list.short)} />
        <div set:html={usageBlocks(slug, rows)} />
      </section>

      <section id="sec-price" class="tb-prose mt-10 scroll-mt-28">
        <h2>{list.short} price in Malaysia: what to expect</h2>
        <div set:html={priceBandCopy(slug, rows)} />
      </section>

      <section id="sec-how" class="tb-prose mt-10 scroll-mt-28">
        <h2>How we chose</h2>
        <div set:html={list.how} />
        <p>
          We started with a long list, removed anything not sold in Malaysia, then scored
          each product on seven weighted criteria. Commission rates are never part of
          scoring. Read <a href="/how-we-rank">methodology</a> and{' '}
          <a href="/editorial-policy">editorial policy</a>.
        </p>
      </section>

      <section id="sec-guide" class="tb-prose mt-10 scroll-mt-28">
        <h2>Buying guide: what to check</h2>
        {
          list.guide.map((g) => (
            <section>
              <h3>{g[0]}</h3>
              <div set:html={g[1]} />
            </section>
          ))
        }
      </section>

      <section id="sec-faq" class="mt-10 scroll-mt-28">
        <h2 class="tb-h2">FAQ</h2>
        {
          list.faq.map((f) => (
            <details class="my-2 rounded-[var(--radius-sm)] border border-[var(--tb-line)]">
              <summary class="cursor-pointer px-4 py-3 font-bold">{f[0]}</summary>
              <div class="tb-prose px-4 pb-4" set:html={f[1]} />
            </details>
          ))
        }
      </section>

      <section id="sec-sources" class="tb-prose mt-10 scroll-mt-28">
        <h2>Sources and fact-check notes</h2>
        <p>
          We did not test any product. Each pick cites the pages below, re-read on {SITE_DATE}.
        </p>
        <ul>
          {
            sources.links.map((s) => (
              <li>
                <a href={s.href} target="_blank" rel="noopener nofollow">
                  {s.title}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="tb-callout">
          <strong>What we could not verify.</strong> {sources.gapWarranty} of {rows.length}{' '}
          products have warranty gaps, and {sources.gapPrice} have price estimates.{' '}
          <a href="/contact">Tell us</a> or see <a href="/corrections">corrections</a>.
        </div>
      </section>

      <section class="mt-10">
        <PriceAlertForm client:idle listKey={listSlug!} />
      </section>

      <section class="mt-10">
        <h2 class="tb-h2">Keep reading</h2>
        <div class="mt-3 grid gap-3 sm:grid-cols-3">
          {
            relatedPosts.map(([id, p]) => (
              <a href={`/guides/${id.replace(/^blog-/, '')}`} class="tb-tile">
                <span class="tb-pill">{p.type}</span>
                <h3 class="m-0 tb-h3">{p.h1}</h3>
                <span class="text-xs text-[var(--tb-muted)]">{p.time} read</span>
              </a>
            ))
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>