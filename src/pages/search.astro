---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import SearchPage from '../components/islands/SearchPage';
import { breadcrumbListJsonLd } from '../lib/seo';
---

<BaseLayout
  title="Search TopBestBuy Malaysia"
  description="Search TopBestBuy lists, buying guides and tools for shoppers in Malaysia."
  canonical="/search"
  jsonLd={{
    '@context': 'https://schema.org',
    '@graph': [breadcrumbListJsonLd([{ label: 'Search' }])],
  }}
>
  <Breadcrumbs items={[{ label: 'Search' }]} />

  <div class="mx-auto max-w-2xl py-6">
    <h1 class="tb-h1">Search</h1>
    <SearchPage client:load />
    <a class="tb-section-link mt-4" href="/categories">Browse all lists</a>
  </div>
</BaseLayout>
