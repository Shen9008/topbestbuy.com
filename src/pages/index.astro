---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageSlot from '../components/media/ImageSlot.astro';
import Icon from '../components/ui/Icon.astro';
import PriceAlertForm from '../components/islands/PriceAlertForm';
import HomeValueProps from '../components/sections/HomeValueProps.astro';
import HomeTrustStrip from '../components/sections/HomeTrustStrip.astro';
import HomeBrowseSection from '../components/sections/HomeBrowseSection.astro';
import HomeToolsStrip from '../components/sections/HomeToolsStrip.astro';
import HomeGuidesSection from '../components/sections/HomeGuidesSection.astro';
import { SITE_DATE } from '../data/meta';
import { LISTS } from '../data/lists';
import { listSlugs, topPick } from '../lib/catalog';
import { productFullName } from '../lib/format';
import { LIST_SLUG_ICONS } from '../icons';

const tops = listSlugs().map((slug) => topPick(slug)).filter(Boolean);
---

<BaseLayout
  title="Top 10 best buys for Malaysia"
  description="Ten picks, clear reasons, no hype. Scored Top 10 lists for appliances, home and lifestyle in Malaysia."
>
  <section class="tb-hero tb-reveal">
    <p class="text-xs font-semibold text-[var(--tb-muted)]">
      Malaysia edition · updated {SITE_DATE} · prices in MYR
    </p>
    <h1 class="tb-h1 mt-3">
      Ten picks. Clear reasons. No hype.
    </h1>
    <p class="mx-auto mt-4 max-w-[42ch] text-lg text-[var(--tb-muted)]">
      Every Top 10 is scored on a published scorecard, with dated prices, trade-offs and the sources behind each pick.
    </p>
    <div class="tb-search-hero" aria-label="Open site search">
      <span class="flex min-w-0 flex-1 items-center gap-2 text-sm text-[var(--tb-muted)]">
        <Icon name="nav.search" size={20} strokeWidth={2} />
        <span class="truncate">Search lists, guides and tools</span>
        <kbd class="ml-auto hidden rounded border border-[var(--tb-line)] px-1.5 py-0.5 text-[10px] font-bold text-[var(--tb-muted)] sm:inline">⌘K</kbd>
      </span>
      <button type="button" id="home-open-search" class="tb-btn">Search</button>
    </div>
    <p class="mt-3 text-xs text-[var(--tb-muted)]">
      Or <a href="/tools?tool=finder">take the 3-question finder</a>
    </p>
  </section>

  <script is:inline>
    document.getElementById('home-open-search')?.addEventListener('click', () => {
      window.dispatchEvent(new Event('tb-open-search'));
    });
  </script>

  <section class="grid items-start gap-8 pb-6 lg:grid-cols-[1fr_0.9fr]">
    <div class="tb-reveal-stagger space-y-2" aria-label="Current number one picks">
        {
          tops.slice(0, 5).map(
            (p) =>
              p && (
                <a
                  href={`/${p.list}`}
                  class="grid grid-cols-[auto_1fr_auto] items-center gap-3 rounded-[var(--radius-md)] border border-[var(--tb-line)] bg-[var(--tb-surface)] p-3 no-underline"
                >
                  <span class="tb-rank">1</span>
                  <span>
                    <strong class="text-[var(--tb-ink)]">{productFullName(p)}</strong>
                    <br />
                    <small class="text-[var(--tb-muted)]">
                      {LISTS[p.list as keyof typeof LISTS].short} · {p.tag}
                    </small>
                  </span>
                  <span class="tb-score text-lg">{p.total.toFixed(1)}</span>
                </a>
              ),
          )
        }
      <p class="text-xs text-[var(--tb-muted)]">
        Scores are editor judgments from scorecard v1.0. <a href="/categories">See all lists</a>
      </p>
    </div>
    <div class="hidden lg:block">
      <ImageSlot slotId="home-hero" aspect="banner" label="Home hero banner" />
    </div>
  </section>

  <div class="mt-4 flex flex-wrap justify-center gap-2 lg:mt-0">
    {listSlugs().slice(0, 8).map((slug) => {
      const icon = LIST_SLUG_ICONS[slug];
      return (
        <a href={`/${slug}`} class="tb-chip inline-flex items-center gap-1.5">
          {icon ? <Icon name={icon} size={16} /> : null}
          {LISTS[slug as keyof typeof LISTS].short}
        </a>
      );
    })}
  </div>

  <HomeValueProps />
  <HomeTrustStrip />
  <HomeBrowseSection />
  <HomeToolsStrip />
  <HomeGuidesSection />

  <section class="tb-section grid gap-6 pb-6 lg:grid-cols-2">
    <div class="tb-card">
      <h2 class="mt-0 tb-h3">What should we rank next?</h2>
      <p class="text-sm text-[var(--tb-muted)]">
        Vote on the next Top 10. Demand also guides our research queue.
      </p>
      <a href="/coming-next" class="tb-btn mt-3">Vote now</a>
    </div>
    <PriceAlertForm client:idle listKey="home" />
  </section>
</BaseLayout>