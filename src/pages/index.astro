---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageSlot from '../components/media/ImageSlot.astro';
import Icon from '../components/ui/Icon.astro';
import PriceAlertForm from '../components/islands/PriceAlertForm';
import HomeValueProps from '../components/sections/HomeValueProps.astro';
import HomeTrustStrip from '../components/sections/HomeTrustStrip.astro';
import HomeBrowseSection from '../components/sections/HomeBrowseSection.astro';
import HomeToolsStrip from '../components/sections/HomeToolsStrip.astro';
import HomeGuidesSection from '../components/sections/HomeGuidesSection.astro';
import HomeTrustEarn from '../components/sections/HomeTrustEarn.astro';
import HomeMethodologySection from '../components/sections/HomeMethodologySection.astro';
import EditorialSection from '../components/sections/EditorialSection.astro';
import BrandLogoStrip from '../components/sections/BrandLogoStrip.astro';
import { SITE_DATE } from '../data/meta';
import { LISTS } from '../data/lists';
import { listSlugs, topPick } from '../lib/catalog';
import { productFullName } from '../lib/format';
import ProductThumb from '../components/media/ProductThumb.astro';
import { LIST_SLUG_ICONS } from '../icons';
import { HOME, homePageJsonLd } from '../lib/seo';

const heroPicks = listSlugs()
  .map((slug) => topPick(slug))
  .filter(Boolean)
  .slice(0, 5);
const listCount = listSlugs().length;
---

<BaseLayout
  title={HOME.title}
  description={HOME.description}
  canonical="/"
  ogImage="/images/editorial/home-hero-cutouts.webp"
  jsonLd={homePageJsonLd()}
>
  <section class="tb-hero tb-hero--editorial tb-hero--hub tb-hero--has-media tb-reveal tb-reveal--hero" aria-label="Introduction">
    <div>
      <p class="m-0 text-xs font-semibold uppercase tracking-wide text-[var(--tb-muted)]">
        Malaysia edition · updated {SITE_DATE} · prices in MYR
      </p>
      <h1 class="tb-h1 mt-3 max-w-[18ch] lg:max-w-none">
        Ten picks. Clear reasons. No <span class="tb-heading-accent">hype</span>.
      </h1>
      <p class="mx-0! mt-4 max-w-[42ch] text-lg text-[var(--tb-muted)]">
        Before you spend, see the short list. Every Top 10 is scored on a published scorecard,
        with dated prices, trade-offs and the sources behind each pick.
      </p>
      <a href="/search" data-open-overlay="search" class="tb-search-hero mx-0 mt-6 max-w-xl no-underline" aria-label="Search the site">
        <span class="flex min-w-0 flex-1 items-center gap-2 text-sm text-[var(--tb-muted)]">
          <Icon name="nav.search" size={20} strokeWidth={2} />
          <span class="truncate">Search air fryer, mattress, purifier…</span>
        </span>
        <span class="tb-btn" aria-hidden="true">Search</span>
      </a>
      <div class="tb-scroll-strip mt-4 lg:flex lg:flex-wrap lg:overflow-visible lg:pb-0">
        {
          listSlugs().map((slug) => {
            const icon = LIST_SLUG_ICONS[slug];
            return (
              <a href={`/${slug}`} class="tb-chip inline-flex shrink-0 items-center gap-1.5">
                {icon ? <Icon name={icon} size={16} /> : null}
                {LISTS[slug as keyof typeof LISTS].short}
              </a>
            );
          })
        }
        <a href="/tools?tool=finder" class="tb-chip inline-flex shrink-0 font-semibold">
          Not sure? Take the 3-question finder
        </a>
      </div>
    </div>
    <div class="flex min-h-0 w-full flex-col gap-3 lg:w-[500px] lg:shrink-0">
      <div class="tb-hero__media">
        <ImageSlot slotId="home-hero" aspect="match" label="Home hero banner" class="h-full min-h-0 w-full" loading="eager" />
      </div>
      <div class="grid gap-2" aria-label="Current number one picks">
        {
          heroPicks.map(
            (p) =>
              p && (
                <a href={`/${p.list}`} class="tb-feed-row tb-feed-row--product">
                  <span class="tb-rank">1</span>
                  <ProductThumb productId={p.id} alt={productFullName(p)} size="sm" decorative />
                  <span class="min-w-0">
                    <strong class="block truncate text-[var(--tb-ink)]">{productFullName(p)}</strong>
                    <small class="text-[var(--tb-muted)]">
                      {LISTS[p.list as keyof typeof LISTS].short} · {p.tag}
                    </small>
                  </span>
                  <span class="tb-score text-lg">{p.total.toFixed(1)}</span>
                </a>
              ),
          )
        }
        <p class="m-0 text-xs text-[var(--tb-muted)]">
          Scores are editor judgments from scorecard v1.0, not lab tests.{' '}
          <a href="/categories">See all {listCount} lists</a>
        </p>
      </div>
    </div>
  </section>

  <div class="tb-page-bands">
    <BrandLogoStrip />

    <HomeValueProps />
    <HomeTrustStrip />

    <EditorialSection band="auto" aria-label="Trust principles">
      <HomeTrustEarn />
    </EditorialSection>

    <EditorialSection band="auto">
      <HomeBrowseSection bare />
    </EditorialSection>

    <HomeToolsStrip />
    <HomeMethodologySection />
    <HomeGuidesSection />

    <EditorialSection band="auto">
      <div class="grid gap-6 lg:grid-cols-2">
        <div class="tb-card">
          <p class="text-xs font-bold uppercase tracking-wide text-[var(--tb-muted)]">You decide</p>
          <h2 class="mt-2 tb-h3">What should we rank next?</h2>
          <p class="text-sm text-[var(--tb-muted)]">
            Vote on the next Top 10. Demand also guides our research queue.
          </p>
          <a href="/coming-next" class="tb-btn mt-3">Vote now</a>
        </div>
        <PriceAlertForm client:idle listKey="home" />
      </div>
    </EditorialSection>
  </div>
</BaseLayout>
