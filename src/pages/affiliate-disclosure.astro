---
import BaseLayout from '../layouts/BaseLayout.astro';
import StubShell from '../components/pages/StubShell.astro';
import { TRUST_META } from '../lib/seo';
---

<BaseLayout
  title={TRUST_META['affiliate-disclosure'].title}
  description={TRUST_META['affiliate-disclosure'].description}
  canonical="/affiliate-disclosure"
>
  <StubShell
    title="Affiliate disclosure"
    kicker="Trust"
    description="Some links earn commission at no extra cost to you. Rankings are set before any commercial review and never move for payment. Full policy text lands here soon."
  />
</BaseLayout>