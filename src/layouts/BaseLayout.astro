---
import '../styles/global.css';
import Seo from '../components/seo/Seo.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import type { JsonLd as JsonLdGraph } from '../lib/seo';
import SkipLink from '../components/layout/SkipLink.astro';
import UtilBanner from '../components/layout/UtilBanner.astro';
import SiteTopBar from '../components/layout/SiteTopBar.astro';
import CategoryRail from '../components/layout/CategoryRail.astro';
import SiteFooter from '../components/layout/SiteFooter.astro';
import MobileTabBar from '../components/layout/MobileTabBar.astro';
import AppChrome from '../components/islands/AppChrome';
import BackToTop from '../components/ui/BackToTop.astro';
import ScrollMotion from '../components/motion/ScrollMotion.astro';
import { siteOrganizationGraph } from '../lib/json-ld';

const orgLd = JSON.stringify(siteOrganizationGraph());

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  jsonLd?: JsonLdGraph | JsonLdGraph[];
}

const { title, description, canonical, ogImage, ogType, noindex, jsonLd } = Astro.props;
---

<!doctype html>
<html lang="en-MY" data-theme="dark">
  <head>
    <Seo
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
    />
    <script type="application/ld+json" set:html={orgLd} />
    {jsonLd && <JsonLd data={jsonLd} />}
    <script is:inline>
      try {
        const t = localStorage.getItem('tb-theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {
        /* localStorage unavailable */
      }
    </script>
  </head>
  <body class="min-h-screen antialiased">
    <SkipLink />
    <UtilBanner />
    <div class="flex min-h-screen flex-col">
      <div class="sticky top-0 z-[var(--z-sticky)]">
        <SiteTopBar />
        <CategoryRail />
      </div>
      <main
        id="main"
        class="mx-auto w-full max-w-[var(--content-max)] flex-1 px-4 py-8 pb-[calc(var(--tabbar-height)+2rem)] lg:pb-12"
      >
        <slot />
      </main>
      <SiteFooter />
    </div>
    <MobileTabBar />
    <BackToTop />
    <AppChrome client:load />
    <ScrollMotion />
  </body>
</html>